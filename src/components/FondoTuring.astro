---
// Componente de Fondo Turing con simulación Reacción-Difusión Gray-Scott auto-limpiable
---

<div class="fixed inset-0 -z-20 w-full h-full bg-[#F4F1EA] overflow-hidden pointer-events-none">
  <canvas id="turing-bg-canvas" class="w-full h-full opacity-[0.55] transition-opacity duration-1000"></canvas>
</div>

<script>
  let turingAnimationId: number | null = null;

  function initTuringBackground() {
    const canvas = document.getElementById('turing-bg-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Resolución interna optimizada para evitar congelamientos de CPU
    const gridW = 1000;
    const gridH = 650;

    let currentU = new Float32Array(gridW * gridH);
    let currentV = new Float32Array(gridW * gridH);
    let nextU = new Float32Array(gridW * gridH);
    let nextV = new Float32Array(gridW * gridH);

    // Parámetros estables de Gray-Scott
    const Feed = 0.037;
    const Kill = 0.060;
    const Da = 0.6;
    const Db = 0.2;

    // Inicializar matrices
    for (let i = 0; i < gridW * gridH; i++) {
      currentU[i] = 1.0;
      currentV[i] = 0.0;
    }

    // Semilla perturbadora central
    const cx = Math.floor(gridW / 2);
    const cy = Math.floor(gridH / 2);
    const rSeed = 20;
    for (let y = cy - rSeed; y <= cy + rSeed; y++) {
      for (let x = cx - rSeed; x <= cx + rSeed; x++) {
        if (x >= 0 && x < gridW && y >= 0 && y < gridH) {
          const idx = x + y * gridW;
          currentU[idx] = 0.5;
          currentV[idx] = 0.25 + Math.random() * 0.4;
        }
      }
    }

    // Adaptar tamaño físico del lienzo
    let canvasW = canvas.width = window.innerWidth;
    let canvasH = canvas.height = window.innerHeight;

    const onResize = () => {
      if (!canvas || !canvas.isConnected) {
        window.removeEventListener('resize', onResize);
        return;
      }
      canvasW = canvas.width = window.innerWidth;
      canvasH = canvas.height = window.innerHeight;
    };
    window.addEventListener('resize', onResize);

    // Bucle de simulación con guardia de desconexión del DOM
    function step() {
      // --- DETECTOR ATÓMICO DE FUGAS DE ANIMACIÓN ---
      if (!canvas || !canvas.isConnected) {
        console.log("[TURING_DIAGNOSTIC] Canvas desmontado. Deteniendo bucle Gray-Scott.");
        if (turingAnimationId !== null) {
          cancelAnimationFrame(turingAnimationId);
          turingAnimationId = null;
        }
        return;
      }

      // Realizar 8 iteraciones matemáticas de difusión por frame
      for (let iter = 0; iter < 8; iter++) {
        for (let y = 1; y < gridH - 1; y++) {
          for (let x = 1; x < gridW - 1; x++) {
            const idx = x + y * gridW;
            const u = currentU[idx];
            const v = currentV[idx];

            // Operador Laplaciano de convolución discreta de 9 puntos
            const lapU = (
              currentU[idx - 1] + currentU[idx + 1] +
              currentU[idx - gridW] + currentU[idx + gridW]
            ) * 0.2 + (
              currentU[idx - gridW - 1] + currentU[idx - gridW + 1] +
              currentU[idx + gridW - 1] + currentU[idx + gridW + 1]
            ) * 0.05 - u;

            const lapV = (
              currentV[idx - 1] + currentV[idx + 1] +
              currentV[idx - gridW] + currentV[idx + gridW]
            ) * 0.2 + (
              currentV[idx - gridW - 1] + currentV[idx - gridW + 1] +
              currentV[idx + gridW - 1] + currentV[idx + gridW + 1]
            ) * 0.05 - v;

            const uv2 = u * v * v;
            nextU[idx] = u + (Da * lapU - uv2 + Feed * (1.0 - u));
            nextV[idx] = v + (Db * lapV + uv2 - (Kill + Feed) * v);
          }
        }
        // Intercambiar buffers
        const tempU = currentU; currentU = nextU; nextU = tempU;
        const tempV = currentV; currentV = nextV; nextV = tempV;
      }

      // Renderizar matriz a baja resolución mediante escalado lineal suave
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = gridW;
      tempCanvas.height = gridH;
      const tempCtx = tempCanvas.getContext('2d')!;
      const imgData = tempCtx.createImageData(gridW, gridH);

      for (let i = 0; i < gridW * gridH; i++) {
        const u = currentU[i];
        const v = currentV[i];
        const pixelIdx = i * 4;
        
        // Mapeo cromático Verde Salvia (#4E5E52) sobre Beige basal
        imgData.data[pixelIdx] = 78;     // R
        imgData.data[pixelIdx + 1] = 94; // G
        imgData.data[pixelIdx + 2] = 82; // B
        imgData.data[pixelIdx + 3] = Math.floor(v * 255 * 1.6); // Canal Alpha proporcional al reactivo
      }

      tempCtx.putImageData(imgData, 0, 0);
      ctx!.clearRect(0, 0, canvasW, canvasH);
      ctx!.imageSmoothingEnabled = true;
      ctx!.drawImage(tempCanvas, 0, 0, canvasW, canvasH);

      turingAnimationId = requestAnimationFrame(step);
    }

    // Escuchas interactivos auto-limpiables
    const handleInteraction = (clientX: number, clientY: number) => {
      const gridX = Math.floor((clientX / window.innerWidth) * gridW);
      const gridY = Math.floor((clientY / window.innerHeight) * gridH);
      const r = 20;

      for (let dy = -r; dy <= r; dy++) {
        for (let dx = -r; dx <= r; dx++) {
          const nx = gridX + dx;
          const ny = gridY + dy;
          if (nx >= 0 && nx < gridW && ny >= 0 && ny < gridH) {
            if (dx * dx + dy * dy < r * r) {
              const idx = nx + ny * gridW;
              currentU[idx] = 0.2;
              currentV[idx] = 0.7 + Math.random() * 0.3;
            }
          }
        }
      }
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!canvas.isConnected) {
        window.removeEventListener('mousemove', onMouseMove);
        return;
      }
      if (Math.random() < 0.25) handleInteraction(e.clientX, e.clientY);
    };

    const onTouchMove = (e: TouchEvent) => {
      if (!canvas.isConnected) {
        window.removeEventListener('touchmove', onTouchMove);
        return;
      }
      if (e.touches[0] && Math.random() < 0.25) {
        handleInteraction(e.touches[0].clientX, e.touches[0].clientY);
      }
    };

    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('touchmove', onTouchMove);

    step();
  }

  // Inicialización con Astro ViewTransitions
  document.addEventListener('astro:page-load', () => {
    if (turingAnimationId !== null) {
      cancelAnimationFrame(turingAnimationId);
      turingAnimationId = null;
    }
    initTuringBackground();
  });
</script>