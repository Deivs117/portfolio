---
// Componente de Fondo Turing con simulación Reacción-Difusión Gray-Scott
// Configurado con contraste ultra suave para servir como marca de agua orgánica interactiva
---

<div class="fixed inset-0 -z-20 w-full h-full bg-bio-bg overflow-hidden pointer-events-none">
  <canvas id="turing-bg-canvas" class="w-full h-full opacity-[0.22] transition-opacity duration-1000"></canvas>
</div>

<script>
  // Función para inicializar la simulación matemática al cargar la página
  function initTuringBackground() {
    const canvas = document.getElementById('turing-bg-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Resolución interna de cómputo baja para asegurar 60 FPS en cualquier dispositivo
    const gridW = 90;
    const gridH = 60;

    let currentU = new Float32Array(gridW * gridH);
    let currentV = new Float32Array(gridW * gridH);
    let nextU = new Float32Array(gridW * gridH);
    let nextV = new Float32Array(gridW * gridH);

    // Parámetros físicos del modelo de Gray-Scott (Patrones estables de manchas y líneas)
    const Du = 0.14;
    const Dv = 0.07;
    const feed = 0.037;
    const kill = 0.060;

    // Colores de mezcla (Pasteles ultra suaves de tu paleta)
    // Fondo: Beige Base (#F4F1EA) -> Mezclado con Verde Salvia muy sutil (#EAECE8) y un toque de Palo de rosa
    const colorBg = { r: 244, g: 241, b: 234 }; 
    const colorPattern = { r: 218, g: 224, b: 219 }; // Verde Salvia pastel super lavado

    function resetSimulation() {
      for (let i = 0; i < gridW * gridH; i++) {
        currentU[i] = 1.0;
        currentV[i] = 0.0;
      }
      
      // Sembrar gotas caóticas
      for (let s = 0; s < 8; s++) {
        const startX = Math.floor(Math.random() * (gridW - 20)) + 10;
        const startY = Math.floor(Math.random() * (gridH - 20)) + 10;
        const r = 5;
        for (let dy = -r; dy <= r; dy++) {
          for (let dx = -r; dx <= r; dx++) {
            if (dx*dx + dy*dy < r*r) {
              const idx = (startX + dx) + (startY + dy) * gridW;
              currentU[idx] = 0.5;
              currentV[idx] = 0.25 + Math.random() * 0.4;
            }
          }
        }
      }
    }

    // Laplaciano de 9 puntos para simular difusión espacial
    function laplacian(x: number, y: number, arr: Float32Array) {
      let sum = 0;
      const centerVal = arr[x + y * gridW];
      
      const left = arr[((x - 1 + gridW) % gridW) + y * gridW];
      const right = arr[((x + 1) % gridW) + y * gridW];
      const top = arr[x + (((y - 1 + gridH) % gridH) * gridW)];
      const bottom = arr[x + (((y + 1) % gridH) * gridW)];
      
      const topLeft = arr[((x - 1 + gridW) % gridW) + (((y - 1 + gridH) % gridH) * gridW)];
      const topRight = arr[((x + 1) % gridW) + (((y - 1 + gridH) % gridH) * gridW)];
      const bottomLeft = arr[((x - 1 + gridW) % gridW) + (((y + 1) % gridH) * gridW)];
      const bottomRight = arr[((x + 1) % gridW) + (((y + 1) % gridH) * gridW)];

      sum += centerVal * -1.0;
      sum += (left + right + top + bottom) * 0.2;
      sum += (topLeft + topRight + bottomLeft + bottomRight) * 0.05;
      
      return sum;
    }

    function step() {
      // Optimizamos ejecutando 4 sub-pasos matemáticos por frame para acelerar el crecimiento del patrón
      const subSteps = 4;
      for (let s = 0; s < subSteps; s++) {
        for (let y = 0; y < gridH; y++) {
          for (let x = 0; x < gridW; x++) {
            const i = x + y * gridW;
            const u = currentU[i];
            const v = currentV[i];
            
            const lU = laplacian(x, y, currentU);
            const lV = laplacian(x, y, currentV);
            
            const reaction = u * v * v;
            
            nextU[i] = u + (Du * lU - reaction + feed * (1.0 - u));
            nextV[i] = v + (Dv * lV + reaction - (feed + kill) * v);

            if (nextU[i] < 0) nextU[i] = 0;
            if (nextU[i] > 1) nextU[i] = 1;
            if (nextV[i] < 0) nextV[i] = 0;
            if (nextV[i] > 1) nextV[i] = 1;
          }
        }
        
        let temp = currentU; currentU = nextU; nextU = temp;
        temp = currentV; currentV = nextV; nextV = temp;
      }
    }

    const imgData = ctx.createImageData(gridW, gridH);
    function draw() {
      for (let i = 0; i < gridW * gridH; i++) {
        const v = currentV[i];
        const factor = Math.min(Math.max(v * 4.0, 0.0), 1.0); // Contraste suave

        // Degradado lineal entre color de fondo beige y patrón verde mudo suave
        const r = Math.floor(colorBg.r + (colorPattern.r - colorBg.r) * factor);
        const g = Math.floor(colorBg.g + (colorPattern.g - colorBg.g) * factor);
        const b = Math.floor(colorBg.b + (colorPattern.b - colorBg.b) * factor);

        const pxIdx = i * 4;
        imgData.data[pxIdx] = r;
        imgData.data[pxIdx + 1] = g;
        imgData.data[pxIdx + 2] = b;
        imgData.data[pxIdx + 3] = 255;
      }

      // Escalado suave por interpolación bilineal
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = gridW;
      tempCanvas.height = gridH;
      tempCanvas.getContext('2d')?.putImageData(imgData, 0, 0);

      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(tempCanvas, 0, 0, canvas.width, canvas.height);
    }

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    // Interacción: inyectar perturbaciones al mover el mouse en el documento
    function handleInteraction(clientX: number, clientY: number) {
      const gridX = Math.floor((clientX / window.innerWidth) * gridW);
      const gridY = Math.floor((clientY / window.innerHeight) * gridH);

      const r = 4;
      for (let dy = -r; dy <= r; dy++) {
        for (let dx = -r; dx <= r; dx++) {
          const nx = gridX + dx;
          const ny = gridY + dy;
          if (nx >= 0 && nx < gridW && ny >= 0 && ny < gridH) {
            if (dx*dx + dy*dy < r*r) {
              const idx = nx + ny * gridW;
              currentU[idx] = 0.1;
              currentV[idx] = 0.8 + Math.random() * 0.2;
            }
          }
        }
      }
    }

    window.addEventListener('mousemove', (e) => {
      // Inyectar reactivo con baja probabilidad para evitar sobrecargar la simulación
      if (Math.random() < 0.15) {
        handleInteraction(e.clientX, e.clientY);
      }
    });

    window.addEventListener('touchmove', (e) => {
      if (e.touches[0] && Math.random() < 0.15) {
        handleInteraction(e.touches[0].clientX, e.touches[0].clientY);
      }
    });

    window.addEventListener('resize', resize);
    
    resize();
    resetSimulation();

    function loop() {
      step();
      draw();
      requestAnimationFrame(loop);
    }

    loop();
  }

  // Ejecutar en la carga inicial y tras las transiciones de página de Astro
  document.addEventListener('astro:page-load', initTuringBackground);
</script>