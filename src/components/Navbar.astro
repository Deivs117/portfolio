---
// Navbar adaptado al diseño de "Grid-Orgánico" con bordes finos y alta sofisticación
const activePath = Astro.url.pathname;
const base = "/portfolio";

// Helper para saber si un enlace es el activo
const isActive = (path: string) => {
  if (path === `${base}/` || path === `${base}`) {
    return activePath === `${base}/` || activePath === `${base}`;
  }
  return activePath.startsWith(path);
};
---

<header class="w-full border-b border-bio-text/10 sticky top-0 bg-bio-bg/80 backdrop-blur-md z-40">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    
    <!-- Identidad / Logo -->
    <a href={`${base}/`} class="flex items-center gap-2 group">
      <span class="font-code text-[10px] px-2 py-0.5 bg-bio-green text-bio-bg rounded font-bold transition-transform group-hover:scale-105">
        MEKA-AI
      </span>
      <span class="font-tech font-bold text-lg tracking-tight text-bio-text group-hover:text-bio-green transition-colors">
        Deiv Portfolio
      </span>
    </a>

    <!-- Menú de Ventanas Independientes -->
    <nav class="flex items-center gap-2 md:gap-6">
      <a 
        href={`${base}/`} 
        class={`font-code text-xs px-3 py-1.5 rounded-lg transition-all ${
          isActive(`${base}/`) 
            ? "bg-bio-green text-bio-bg font-bold shadow-sm" 
            : "text-bio-text/70 hover:text-bio-text hover:bg-bio-text/5"
        }`}
      >
        Sobre mí
      </a>
      
      <a 
        href={`${base}/proyectos/`} 
        class={`font-code text-xs px-3 py-1.5 rounded-lg transition-all ${
          isActive(`${base}/proyectos`) 
            ? "bg-bio-green text-bio-bg font-bold shadow-sm" 
            : "text-bio-text/70 hover:text-bio-text hover:bg-bio-text/5"
        }`}
      >
        Proyectos
      </a>

      <a 
        href={`${base}/divulgacion/`} 
        class={`font-code text-xs px-3 py-1.5 rounded-lg transition-all ${
          isActive(`${base}/divulgacion`) 
            ? "bg-bio-green text-bio-bg font-bold shadow-sm" 
            : "text-bio-text/70 hover:text-bio-text hover:bg-bio-text/5"
        }`}
      >
        Divulgación
      </a>

      <a 
        href={`${base}/personal/`} 
        class={`font-code text-xs px-3 py-1.5 rounded-lg transition-all ${
          isActive(`${base}/personal`) 
            ? "bg-bio-green text-bio-bg font-bold shadow-sm" 
            : "text-bio-text/70 hover:text-bio-text hover:bg-bio-text/5"
        }`}
      >
        Personal
      </a>
    </nav>

  </div>
</header>