---
// Componente modular premium para el experimento cuántico de la Doble Rendija con sistema auto-limpiable (TypeScript Safe)
---

<div class="w-full h-full flex flex-col">
  <div class="pb-3 flex justify-between items-center shrink-0 border-b border-bio-text/5 bg-white/40 px-4 rounded-t-2xl bg-white/30 backdrop-blur-sm">
    <div class="flex items-center gap-2">
      <span class="font-code text-[10px] px-2 py-0.5 bg-bio-blue text-white rounded font-bold">QUANTUM_WAVE</span>
      <span class="font-code text-[10px] text-bio-blue font-bold">[LAB_03] INTERFERÓMETRO DE DOBLE RENDIJA</span>
    </div>
    <button id="btn-observer-toggle" class="px-2.5 py-1 text-[9px] font-code bg-bio-blue text-white rounded-md font-bold transition-all hover:scale-[1.02] shadow-sm">
      👁️ AÑADIR OBSERVADOR
    </button>
  </div>
  <div class="flex-grow bg-[#121314] border border-bio-text/10 rounded-b-2xl overflow-hidden relative min-h-[380px] mt-4">
    <canvas id="canvas-cuantica" class="w-full h-full block outline-none"></canvas>
    
    <div class="absolute bottom-3 left-3 text-[9px] font-code text-bio-bg/50 pointer-events-none" id="quantum-status-text">
      ESTADO: ONDA RECTORA (MÚLTIPLE INTERFERENCIA)
    </div>

    <div class="absolute top-3 right-3 text-[8px] font-code text-white bg-black/60 px-2.5 py-1.5 rounded-md border border-white/5 shadow-md flex gap-3 pointer-events-none z-10">
      <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 bg-bio-blue rounded-full"></span> Ondas (Sin Obs.)</span>
      <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 bg-bio-rose rounded-full"></span> Partículas (Con Obs.)</span>
    </div>
  </div>
</div>

<script>
  let quantumAnimationId: number | null = null;
  let isRunning = false;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;

  function initQuantumSimulator() {
    canvas = document.getElementById('canvas-cuantica') as HTMLCanvasElement;
    if (!canvas) return;

    ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    let W = canvas.parentElement!.clientWidth || 600;
    let H = canvas.parentElement!.clientHeight || 410;

    const dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    let hasObserver = false;
    let qTime = 0;

    interface Particle {
      x: number;
      y: number;
      r: number;
      vx: number;
      vy: number;
      mode: 'wave' | 'particle';
      hasDiffracted?: boolean;
    }
    let qParticles: Particle[] = [];
    
    interface ImpactSpark {
      x: number;
      y: number;
      vx: number;
      vy: number;
      color: string;
      alpha: number;
      size: number;
    }
    let impactSparks: ImpactSpark[] = [];

    const histBins = 55;
    let histHitsWave = Array(histBins).fill(0);      
    let histHitsParticle = Array(histBins).fill(0);  

    const btn = document.getElementById('btn-observer-toggle');
    if (btn) {
      (btn as any).onclick = (e: Event) => {
        hasObserver = !hasObserver;
        const status = document.getElementById('quantum-status-text');
        
        if (hasObserver) {
          btn.classList.replace('bg-bio-blue', 'bg-bio-rose');
          btn.innerHTML = '👁️ QUITAR OBSERVADOR';
          if (status) status.innerText = "ESTADO: COHERENCIA DESTRUIDA (MEDICIÓN DE PARTÍCULA)";
        } else {
          btn.classList.replace('bg-bio-rose', 'bg-bio-blue');
          btn.innerHTML = '👁️ AÑADIR OBSERVADOR';
          if (status) status.innerText = "ESTADO: ONDA RECTORA (MÚLTIPLE INTERFERENCIA)";
        }
      };
    }

    function spawnSparks(x: number, y: number, color: string) {
      const count = Math.floor(Math.random() * 4) + 4; 
      for (let i = 0; i < count; i++) {
        impactSparks.push({
          x: x,
          y: y,
          vx: -(Math.random() * 2.2 + 0.6), 
          vy: (Math.random() - 0.5) * 2.5,  
          color: color,
          alpha: 1.0,
          size: Math.random() * 2.5 + 1.0
        });
      }
    }

    function draw() {
      // --- DETECTOR ATÓMICO DE FUGAS DE ANIMACIÓN ---
      if (!canvas || !canvas.isConnected || !isRunning) {
        console.log("[QUANTUM_DIAGNOSTIC] Deteniendo bucle por cambio de pestaña.");
        stopSimulator();
        return;
      }

      const c = ctx;
      if (!c) return;

      c.clearRect(0, 0, W, H);
      qTime += 0.08;

      const emitX = 40;
      const slitX = W * 0.44;
      const screenX = W - 90;
      const dSlits = 50;
      const slit1Y = H / 2 - dSlits / 2;
      const slit2Y = H / 2 + dSlits / 2;

      if (Math.random() < 0.28) {
        if (!hasObserver) {
          qParticles.push({
            x: emitX, y: H / 2, r: 3,
            vx: 4.8, vy: (Math.random() - 0.5) * 1.5,
            mode: 'wave'
          });
        } else {
          const targetY = Math.random() < 0.5 ? slit1Y : slit2Y;
          const angle = Math.atan2(targetY - H / 2, slitX - emitX);
          qParticles.push({
            x: emitX, y: H / 2, r: 4,
            vx: Math.cos(angle) * 5.8,
            vy: Math.sin(angle) * 5.8,
            mode: 'particle',
            hasDiffracted: false
          });
        }
      }

      const hasWaves = qParticles.some(p => p.mode === 'wave');
      if (hasWaves) {
        c.strokeStyle = 'rgba(143, 169, 196, 0.08)'; c.lineWidth = 3;
        for (let r = (qTime * 25) % 50; r < slitX - emitX; r += 50) {
          c.beginPath(); c.arc(emitX, H / 2, r, -Math.PI / 3, Math.PI / 3); c.stroke();
        }
        for (let r = (qTime * 25) % 50; r < screenX - slitX; r += 50) {
          c.beginPath(); c.arc(slitX, slit1Y, r, -Math.PI / 3, Math.PI / 3); c.stroke();
          c.beginPath(); c.arc(slitX, slit2Y, r, -Math.PI / 3, Math.PI / 3); c.stroke();
        }
      }

      qParticles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.mode === 'wave') {
          c.fillStyle = `rgba(143, 169, 196, ${0.45 + Math.sin(qTime) * 0.3})`;
          c.beginPath(); c.arc(p.x, p.y, p.r + Math.sin(qTime * 2) * 2.2, 0, Math.PI * 2); c.fill();
          
          if (Math.abs(p.x - slitX) < 5) {
            p.y = Math.random() < 0.5 ? slit1Y : slit2Y;
            const theta = (Math.random() - 0.5) * 1.25;
            p.vx = Math.cos(theta) * 4.8;
            p.vy = Math.sin(theta) * 4.8;
          }
        } else {
          c.fillStyle = '#D8A499';
          c.beginPath(); c.arc(p.x, p.y, p.r, 0, Math.PI * 2); c.fill();

          if (Math.abs(p.x - slitX) < 6) {
            c.strokeStyle = 'rgba(216,164,153,0.35)'; c.lineWidth = 1;
            c.beginPath(); c.arc(slitX, p.y, 12, 0, Math.PI * 2); c.stroke();

            if (!p.hasDiffracted) {
              p.hasDiffracted = true;
              const u1 = Math.random() || 0.0001;
              const u2 = Math.random() || 0.0001;
              const normalRandom = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
              const theta = normalRandom * 0.16; 
              const speed = 5.8;
              p.vx = Math.cos(theta) * speed;
              p.vy = Math.sin(theta) * speed;
            }
          }
        }

        if (p.x >= screenX) {
          p.x = -999; 
          const bin = Math.floor((p.y / H) * histBins);
          if (bin >= 0 && bin < histBins) {
            if (p.mode === 'wave') {
              const normY = (p.y - H / 2) / (H / 2);
              const intensity = Math.pow(Math.cos(normY * 11.5), 2) * Math.exp(-normY * normY * 1.6);
              if (Math.random() < intensity + 0.05) {
                histHitsWave[bin]++;
                spawnSparks(screenX, p.y, '#8FA9C4'); 
              }
            } else {
              histHitsParticle[bin]++;
              spawnSparks(screenX, p.y, '#D8A499'); 
            }
          }
        }
      });

      qParticles = qParticles.filter(p => p.x > 0);

      const maxHitsWave = Math.max(...histHitsWave, 1);
      const maxHitsParticle = Math.max(...histHitsParticle, 1);
      const unifiedMax = Math.max(maxHitsWave, maxHitsParticle);

      const binH = H / histBins;

      c.fillStyle = hasObserver ? 'rgba(143, 169, 196, 0.15)' : 'rgba(143, 169, 196, 0.75)';
      histHitsWave.forEach((hits, idx) => {
        if (hits > 0) {
          const barWidth = (hits / unifiedMax) * 80;
          c.fillRect(screenX + 3, idx * binH, barWidth, binH - 1.2);
        }
      });

      c.fillStyle = hasObserver ? 'rgba(216, 164, 153, 0.75)' : 'rgba(216, 164, 153, 0.15)';
      histHitsParticle.forEach((hits, idx) => {
        if (hits > 0) {
          const barWidth = (hits / unifiedMax) * 80;
          c.fillRect(screenX + 3, idx * binH, barWidth, binH - 1.2);
        }
      });

      c.save();
      c.globalCompositeOperation = 'screen';
      impactSparks.forEach(spark => {
        c.fillStyle = spark.color;
        c.globalAlpha = spark.alpha;
        c.beginPath();
        c.arc(spark.x, spark.y, spark.size, 0, Math.PI * 2);
        c.fill();
        
        spark.x += spark.vx;
        spark.y += spark.vy;
        spark.alpha -= 0.045; 
      });
      c.restore();
      
      impactSparks = impactSparks.filter(s => s.alpha > 0);

      c.fillStyle = '#4E5E52';
      c.fillRect(slitX - 5, 0, 10, slit1Y - 14);
      c.fillRect(slitX - 5, slit1Y + 14, 10, slit2Y - slit1Y - 28);
      c.fillRect(slitX - 5, slit2Y + 14, 10, H - slit2Y);

      if (hasObserver) {
        c.fillStyle = '#D8A499'; c.strokeStyle = '#F4F1EA'; c.lineWidth = 1.5;
        c.beginPath(); c.arc(slitX, H / 2, 6, 0, Math.PI * 2); c.fill(); c.stroke();
        c.fillStyle = '#121314'; c.beginPath(); c.arc(slitX, H / 2, 2.5, 0, Math.PI * 2); c.fill();
      }

      c.fillStyle = '#E5E7EB'; c.fillRect(screenX, 0, 4, H);

      quantumAnimationId = requestAnimationFrame(draw);
    }

    const onResize = () => {
      if (!canvas || !canvas.isConnected) {
        window.removeEventListener('resize', onResize);
        return;
      }
      W = canvas.parentElement!.clientWidth || 600;
      H = canvas.parentElement!.clientHeight || 410;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx!.scale(dpr, dpr);
    };
    window.addEventListener('resize', onResize);

    draw();
  }

  function startSimulator() {
    stopSimulator();
    isRunning = true;
    setTimeout(() => {
      if (isRunning) initQuantumSimulator();
    }, 60);
  }

  function stopSimulator() {
    isRunning = false;
    if (quantumAnimationId !== null) {
      cancelAnimationFrame(quantumAnimationId);
      quantumAnimationId = null;
    }
  }

  window.addEventListener('tab-changed', (e: any) => {
    if (e.detail.activeTab === 'cuantica') {
      startSimulator();
    } else {
      stopSimulator();
    }
  });

  document.addEventListener('astro:page-load', () => {
    if ((window as any).activeSimulation === 'cuantica') {
      startSimulator();
    } else {
      stopSimulator();
    }
  });
</script>