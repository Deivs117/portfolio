---
// Componente modular de Neuro-Simulación con doble estímulo y sistema auto-limpiable (TypeScript Safe)
---

<div class="w-full h-full flex flex-col">
  <div class="pb-3 flex justify-between items-center shrink-0 border-b border-bio-text/5 bg-white/40 px-4 rounded-t-2xl">
    <div class="flex items-center gap-2">
      <span class="font-code text-[10px] px-2 py-0.5 bg-bio-rose text-white rounded font-bold">NEURO_BIOMIMETIC</span>
      <span class="font-code text-[10px] text-bio-rose font-bold">CIRCUITO DISPARADOR TRANSITORIO DE PRIMERA DERIVADA</span>
    </div>
    <div class="flex items-center gap-2">
      <span id="stimulus-badge" class="font-code text-[9px] px-2 py-0.5 bg-bio-text/10 text-bio-text/70 rounded font-bold transition-all">ESTÍMULO: REPOSO</span>
    </div>
  </div>
  <div class="flex-grow bg-bio-bg/40 border border-bio-text/10 rounded-b-2xl overflow-hidden relative min-h-[410px] w-full">
    <canvas id="canvas-neuro" class="w-full h-full cursor-pointer block outline-none" tabindex="0"></canvas>
    <!-- Leyenda técnica -->
    <div class="absolute top-3 right-3 text-[9px] font-code text-bio-text bg-white/95 px-2.5 py-1.5 rounded-lg border border-bio-text/10 shadow-sm flex gap-3 z-10">
      <span class="text-bio-blue font-bold">■ Entrada r(t)</span>
      <span class="text-neutral-900 font-bold">■ Unidad 3 (Derivada +)</span>
      <span class="text-bio-rose font-bold">■ Unidad 5 (Derivada -)</span>
    </div>
    <!-- Instrucciones de estimulación -->
    <div class="absolute bottom-3 left-3 bg-white/90 px-3 py-1.5 rounded-lg border border-bio-text/10 shadow-sm text-[9px] font-code text-bio-text/70 pointer-events-none max-w-[340px] leading-relaxed z-10">
      💡 <strong class="text-bio-rose">Click / Mantener ratón:</strong> Inyectar Escalón • <strong class="text-bio-rose">Barra Espaciadora:</strong> Inyectar Onda Triangular
    </div>
  </div>
</div>

<script>
  let neuroAnimationId: number | null = null;
  let isRunning = false;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;

  const tau = 0.035; 
  const a = 1, b = 1, c = 1, M = 500, sigma = 30; 
  const dt = 0.001; 

  let E1 = 0, E2 = 0, E3 = 0, E4 = 0, E5 = 0;
  let r = 0;

  let isMouseActive = false;
  let isSpaceActive = false;
  let t_stimulus = 0; 

  let W = 0, H = 0;
  let dpr = 1;

  let plotW = 0;
  let plotR: number[] = [];
  let plotE3: number[] = [];
  let plotE5: number[] = [];

  function handleKeyDown(e: KeyboardEvent) {
    if (!canvas || !canvas.isConnected) {
      window.removeEventListener('keydown', handleKeyDown);
      return;
    }
    if (e.code === 'Space') {
      isSpaceActive = true;
      e.preventDefault(); 
    }
  }

  function handleKeyUp(e: KeyboardEvent) {
    if (!canvas || !canvas.isConnected) {
      window.removeEventListener('keyup', handleKeyUp);
      return;
    }
    if (e.code === 'Space') {
      isSpaceActive = false;
      e.preventDefault();
    }
  }

  function startSimulator() {
    stopSimulator();
    canvas = document.getElementById('canvas-neuro') as HTMLCanvasElement;
    if (!canvas) return;

    ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    isRunning = true;

    setTimeout(() => {
      if (!isRunning || !canvas) return;
      
      resize();
      
      window.removeEventListener('keydown', handleKeyDown);
      window.addEventListener('keydown', handleKeyDown);
      window.removeEventListener('keyup', handleKeyUp);
      window.addEventListener('keyup', handleKeyUp);

      canvas.removeEventListener('mousedown', setMouseDown);
      canvas.addEventListener('mousedown', setMouseDown);
      canvas.removeEventListener('mouseup', setMouseUp);
      canvas.addEventListener('mouseup', setMouseUp);
      canvas.removeEventListener('mouseleave', setMouseUp);
      canvas.addEventListener('mouseleave', setMouseUp);

      window.removeEventListener('resize', resize);
      window.addEventListener('resize', resize);

      loop();
    }, 60);
  }

  function stopSimulator() {
    isRunning = false;
    if (neuroAnimationId !== null) {
      cancelAnimationFrame(neuroAnimationId);
      neuroAnimationId = null;
    }
  }

  function setMouseDown() { isMouseActive = true; }
  function setMouseUp() { isMouseActive = false; }

  function resize() {
    if (!canvas || !ctx) return;
    const rect = canvas.getBoundingClientRect();
    
    const width = rect.width || canvas.parentElement?.clientWidth || 600;
    const height = rect.height || canvas.parentElement?.clientHeight || 410;
    
    dpr = window.devicePixelRatio || 1;
    
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    
    ctx.resetTransform();
    ctx.scale(dpr, dpr);
    
    W = width;
    H = height;

    const midX = W * 0.42;
    plotW = Math.floor(W - midX - 35);
    
    plotR = Array(plotW).fill(0);
    plotE3 = Array(plotW).fill(0);
    plotE5 = Array(plotW).fill(0);
  }

  function solvePhysics() {
    for (let step = 0; step < 10; step++) {
      let noise = (Math.random() - 0.5) * 1.8;
      let target_r = 0;

      const badge = document.getElementById('stimulus-badge');

      if (isSpaceActive) {
        t_stimulus += dt * 10; 
        const period = 6.0; 
        const phase = (t_stimulus % period) / period; 
        const amplitude = 25;

        if (phase < 0.5) {
          target_r = 2 * amplitude * phase; 
        } else {
          target_r = 2 * amplitude * (1 - phase); 
        }
        target_r += noise * 0.45; 

        if (badge) {
          badge.innerText = "ESTÍMULO: ONDA TRIANGULAR";
          badge.className = "font-code text-[9px] px-2 py-0.5 bg-bio-blue text-white rounded font-bold animate-pulse";
        }
      } else if (isMouseActive) {
        target_r = 22 + noise; 
        t_stimulus = 0; 

        if (badge) {
          badge.innerText = "ESTÍMULO: ESCALÓN (STEP)";
          badge.className = "font-code text-[9px] px-2 py-0.5 bg-bio-rose text-white rounded font-bold animate-pulse";
        }
      } else {
        target_r = Math.max(0, noise * 0.1); 
        t_stimulus = 0;

        if (badge) {
          badge.innerText = "ESTÍMULO: REPOSO";
          badge.className = "font-code text-[9px] px-2 py-0.5 bg-bio-text/10 text-bio-text/70 rounded font-bold";
        }
      }

      r += (target_r - r) * 0.15;

      E1 += dt * (-E1 + r) / tau;
      E2 += dt * (-E2 + a * E1) / tau;
      
      let term3 = Math.max(0, b * E1 - c * E2);
      E3 += dt * (-E3 + (M * term3 * term3) / (sigma * sigma + term3 * term3)) / tau;
      
      E4 += dt * (-E4 + a * E1) / tau;
      
      let term5 = Math.max(0, b * E4 - c * E1);
      E5 += dt * (-E5 + (M * term5 * term5) / (sigma * sigma + term5 * term5)) / tau;
    }

    plotR.push(r); plotR.shift();
    plotE3.push(E3); plotE3.shift();
    plotE5.push(E5); plotE5.shift();
  }

  function loop() {
    // --- DETECTOR ATÓMICO DE FUGAS DE ANIMACIÓN ---
    if (!canvas || !canvas.isConnected || !isRunning) {
      stopSimulator();
      return;
    }

    const cNode = ctx;
    if (!cNode) return;

    solvePhysics();
    cNode.clearRect(0, 0, W, H);

    const midX = W * 0.40;

    const nodeRadius = 16;
    const nodeX1 = midX * 0.22;
    const nodeX2 = midX * 0.54;
    const nodeX3 = midX * 0.86;

    const nodeY1 = H * 0.5;
    const nodeY2 = H * 0.26;
    const nodeY4 = H * 0.74;
    const nodeY3 = H * 0.35;
    const nodeY5 = H * 0.65;

    const drawSynapse = (x1: number, y1: number, x2: number, y2: number, isInhibitory = false) => {
      const dx = x2 - x1;
      const dy = y2 - y1;
      const dist = Math.sqrt(dx * dx + dy * dy);
      
      if (dist < 2 * nodeRadius) return;

      const ux = dx / dist;
      const uy = dy / dist;

      const sx = x1 + nodeRadius * ux;
      const sy = y1 + nodeRadius * uy;

      const ex = x2 - nodeRadius * ux;
      const ey = y2 - nodeRadius * uy;

      cNode.beginPath();
      cNode.moveTo(sx, sy);

      if (isInhibitory) {
        const dotRadius = 3.5;
        const lx = ex - dotRadius * ux;
        const ly = ey - dotRadius * uy;
        
        cNode.lineTo(lx, ly);
        cNode.strokeStyle = '#D8A499'; cNode.lineWidth = 2.0; cNode.stroke();

        cNode.fillStyle = '#D8A499'; cNode.strokeStyle = '#121314'; cNode.lineWidth = 1.5;
        cNode.beginPath();
        cNode.arc(lx, ly, dotRadius, 0, Math.PI * 2);
        cNode.fill(); cNode.stroke();
      } else {
        cNode.lineTo(ex, ey);
        cNode.strokeStyle = '#4E5E52'; cNode.lineWidth = 2.0; cNode.stroke();

        const arrowLen = 7.5;
        const angle = Math.atan2(dy, dx);
        cNode.fillStyle = '#4E5E52';
        cNode.beginPath();
        cNode.moveTo(ex, ey);
        cNode.lineTo(ex - arrowLen * Math.cos(angle - 0.3), ey - arrowLen * Math.sin(angle - 0.3));
        cNode.lineTo(ex - arrowLen * Math.cos(angle + 0.3), ey - arrowLen * Math.sin(angle + 0.3));
        cNode.fill();
      }
    }

    drawSynapse(15, nodeY1, nodeX1, nodeY1); 
    drawSynapse(nodeX1, nodeY1, nodeX2, nodeY2); 
    drawSynapse(nodeX1, nodeY1, nodeX2, nodeY4); 
    drawSynapse(nodeX1, nodeY1, nodeX3, nodeY3); 
    drawSynapse(nodeX1, nodeY1, nodeX3, nodeY5); 
    drawSynapse(nodeX2, nodeY2, nodeX3, nodeY3, true); 
    drawSynapse(nodeX2, nodeY4, nodeX3, nodeY5, true); 

    const drawNeuronNode = (x: number, y: number, name: string, actVal: number, isInhibitory = false) => {
      const intensity = Math.min(1.0, Math.max(0.15, actVal / 25.0));
      
      cNode.fillStyle = isInhibitory ? `rgba(78,94,82, ${intensity})` : `rgba(216,164,153, ${intensity})`;
      cNode.strokeStyle = '#121314'; cNode.lineWidth = 2.5;
      
      cNode.beginPath();
      cNode.arc(x, y, nodeRadius, 0, Math.PI * 2);
      cNode.fill(); cNode.stroke();

      cNode.fillStyle = '#121314'; cNode.font = "bold 9px Azeret Mono"; cNode.textAlign = "center";
      cNode.fillText(name, x, y + 3.5);
    }

    drawNeuronNode(nodeX1, nodeY1, "U1", E1);
    drawNeuronNode(nodeX2, nodeY2, "U2", E2, true);
    drawNeuronNode(nodeX2, nodeY4, "U4", E4, true);
    drawNeuronNode(nodeX3, nodeY3, "U3", E3);
    drawNeuronNode(nodeX3, nodeY5, "U5", E5);

    const ox = midX + 25;
    const oy = H - 55;
    const plotHeight = H - 90;

    cNode.fillStyle = 'rgba(18, 19, 20, 0.02)'; cNode.fillRect(ox, oy - plotHeight, plotW, plotHeight);
    cNode.strokeStyle = 'rgba(18, 19, 20, 0.08)'; cNode.lineWidth = 1.5;
    cNode.strokeRect(ox, oy - plotHeight, plotW, plotHeight);

    cNode.strokeStyle = 'rgba(18, 19, 20, 0.03)'; cNode.lineWidth = 1;
    for (let i = 1; i < 4; i++) {
      const gy = oy - (plotHeight * (i / 4));
      cNode.beginPath(); cNode.moveTo(ox, gy); cNode.lineTo(ox + plotW, gy); cNode.stroke();
    }

    cNode.fillStyle = '#121314'; cNode.font = "8px Azeret Mono"; cNode.textAlign = "right";
    cNode.fillText("30 E", ox - 6, oy - plotHeight + 3);
    cNode.fillText("15", ox - 6, oy - plotHeight / 2 + 3);
    cNode.fillText("0", ox - 6, oy + 2.5);

    cNode.textAlign = "center";
    cNode.fillText("100ms", ox + plotW * 0.12, oy + 12);
    cNode.fillText("600ms", ox + plotW * 0.62, oy + 12);
    cNode.fillText("1000ms", ox + plotW * 0.95, oy + 12);

    const drawTrace = (data: number[], color: string, thick: number) => {
      cNode.beginPath(); cNode.strokeStyle = color; cNode.lineWidth = thick;
      cNode.lineJoin = 'round';
      
      for (let i = 0; i < data.length; i++) {
        const cx = ox + (i / (data.length - 1)) * plotW;
        const cy = Math.max(oy - plotHeight, Math.min(oy, oy - (data[i] / 30.0) * plotHeight));
        
        if (i === 0) cNode.moveTo(cx, cy);
        else cNode.lineTo(cx, cy);
      }
      cNode.stroke();
    }

    drawTrace(plotE5, '#D8A499', 3.0); 
    drawTrace(plotE3, '#121314', 3.0); 
    drawTrace(plotR, '#8FA9C4', 1.5);  

    neuroAnimationId = requestAnimationFrame(loop);
  }

  window.addEventListener('tab-changed', (e: any) => {
    if (e.detail.activeTab === 'neuro') {
      startSimulator();
    } else {
      stopSimulator();
    }
  });

  document.addEventListener('astro:page-load', () => {
    if ((window as any).activeSimulation === 'neuro') {
      startSimulator();
    } else {
      stopSimulator();
    }
  });
</script>