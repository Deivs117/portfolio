---
// Componente modular para el circuito neuronal integrador de derivada
---

<div class="w-full h-full flex flex-col">
  <div class="pb-3 flex justify-between items-center shrink-0 border-b border-bio-text/5">
    <span class="font-code text-[10px] text-bio-rose font-bold">[LAB_02] CIRCUITO INTEGRADOR DE DERIVADA NEURONAL</span>
    <span class="text-[9px] font-code text-bio-text/60">Haz clic para enfocar. Mantén pulsado o usa la Barra Espaciadora</span>
  </div>
  <div class="flex-grow bg-bio-bg/40 border border-bio-text/10 rounded-xl overflow-hidden relative min-h-[380px] mt-4">
    <canvas id="canvas-neuro" class="w-full h-full cursor-pointer block outline-none" tabindex="0"></canvas>
    <div class="absolute top-3 right-3 text-[9px] font-code text-bio-text bg-white/95 px-2.5 py-1.5 rounded-lg border border-bio-text/10 shadow-sm flex gap-3">
      <span class="text-bio-blue font-bold">■ Entrada r(t)</span>
      <span class="text-neutral-800 font-bold">■ Unidad 3 (Pos)</span>
      <span class="text-bio-rose font-bold">■ Unidad 5 (Neg)</span>
    </div>
  </div>
</div>

<script>
  let neuroAnimationId: number | null = null;

  function initNeuroSimulator() {
    const canvas = document.getElementById('canvas-neuro') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d')!;
    let W = canvas.width = canvas.parentElement!.clientWidth;
    let H = canvas.height = canvas.parentElement!.clientHeight;

    // Variables de estado del modelo de conductancia sináptica (Euler)
    let E1=0, E2=0, E3=0, E4=0, E5=0;
    let r = 0;
    let isInputActive = false;

    const tau = 0.01; // constante de tiempo 10ms
    const a=1, b=1, c=1, M=30, sigma=30; 
    const dt = 0.001; 

    // Buffer de trazado acotado al tamaño real
    const W_plot = Math.floor(W * 0.52);
    let plotR = Array(W_plot).fill(0);
    let plotE3 = Array(W_plot).fill(0);
    let plotE5 = Array(W_plot).fill(0);

    // Eventos de interacción de estímulo
    canvas.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        isInputActive = true;
        e.preventDefault();
      }
    });
    canvas.addEventListener('keyup', (e) => {
      if (e.code === 'Space') {
        isInputActive = false;
        e.preventDefault();
      }
    });
    canvas.addEventListener('mousedown', () => { isInputActive = true; });
    canvas.addEventListener('mouseup', () => { isInputActive = false; });
    canvas.addEventListener('mouseleave', () => { isInputActive = false; });

    // Integración de ecuaciones diferenciales por diferencia de Euler
    function solvePhysics() {
      for (let step = 0; step < 10; step++) {
        let noise = (Math.random() - 0.5) * 1.5;
        let target_r = isInputActive ? 22 + noise : Math.max(0, noise * 0.1);
        r += (target_r - r) * 0.15; // Suavizado de transitorio de entrada r(t)

        // Ecuaciones diferenciales ordinarias de tu investigación
        E1 += dt * (-E1 + r) / tau;
        E2 += dt * (-E2 + a * E1) / tau;
        
        let term3 = Math.max(0, b * E1 - c * E2);
        E3 += dt * (-E3 + (M * term3 * term3) / (sigma * sigma + term3 * term3)) / tau;
        
        E4 += dt * (-E4 + a * E1) / tau;
        
        let term5 = Math.max(0, b * E4 - c * E2);
        E5 += dt * (-E5 + (M * term5 * term5) / (sigma * sigma + term5 * term5)) / tau;
      }

      plotR.push(r); plotR.shift();
      plotE3.push(E3); plotE3.shift();
      plotE5.push(E5); plotE5.shift();
    }

    function draw() {
      solvePhysics();
      ctx.clearRect(0, 0, W, H);

      const midX = W * 0.42;

      // --- 1. GRAFO DE LA RED NEURONAL ACTIVA ---
      const nodeX1 = midX * 0.22;
      const nodeX2 = midX * 0.54;
      const nodeX3 = midX * 0.86;

      const nodeY1 = H * 0.5;
      const nodeY2 = H * 0.26;
      const nodeY4 = H * 0.74;
      const nodeY3 = H * 0.35;
      const nodeY5 = H * 0.65;

      const drawArrow = (x1: number, y1: number, x2: number, y2: number, isInhibitory = false) => {
        ctx.strokeStyle = '#8C7870'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
        
        const angle = Math.atan2(y2 - y1, x2 - x1);
        if (!isInhibitory) {
          ctx.fillStyle = '#8C7870';
          ctx.beginPath();
          ctx.moveTo(x2 - 12 * Math.cos(angle), y2 - 12 * Math.sin(angle));
          ctx.lineTo(x2 - 17 * Math.cos(angle - 0.3), y2 - 17 * Math.sin(angle - 0.3));
          ctx.lineTo(x2 - 17 * Math.cos(angle + 0.3), y2 - 17 * Math.sin(angle + 0.3));
          ctx.fill();
        } else {
          ctx.fillStyle = '#D8A499'; ctx.strokeStyle = '#8C7870';
          ctx.beginPath();
          ctx.arc(x2 - 13 * Math.cos(angle), y2 - 13 * Math.sin(angle), 5, 0, Math.PI * 2);
          ctx.fill(); ctx.stroke();
        }
      }

      // Dibujar cables sinápticos
      drawArrow(10, nodeY1, nodeX1, nodeY1);
      drawArrow(nodeX1, nodeY1, nodeX2, nodeY2); 
      drawArrow(nodeX1, nodeY1, nodeX2, nodeY4); 
      drawArrow(nodeX1, nodeY1, nodeX3, nodeY3); 
      drawArrow(nodeX1, nodeY1, nodeX3, nodeY5); 
      drawArrow(nodeX2, nodeY2, nodeX3, nodeY3, true); // Inhibición
      drawArrow(nodeX2, nodeY4, nodeX3, nodeY5, true); // Inhibición

      // Dibujar nodos con brillo dinámico
      const drawNode = (x: number, y: number, label: string, val: number, isGreen = false) => {
        // Normalización respecto al valor máximo esperado de disparo (~25-30)
        const alpha = Math.min(1.0, Math.max(0.12, val / 25.0));
        ctx.fillStyle = isGreen ? `rgba(78,94,82, ${alpha})` : `rgba(216,164,153, ${alpha})`;
        ctx.strokeStyle = '#121314'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(x, y, 15, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

        ctx.fillStyle = '#121314'; ctx.font = "bold 9px Azeret Mono"; ctx.textAlign = "center";
        ctx.fillText(label, x, y + 3);
      }

      drawNode(nodeX1, nodeY1, "U1", E1);
      drawNode(nodeX2, nodeY2, "U2", E2, true);
      drawNode(nodeX2, nodeY4, "U4", E4, true);
      drawNode(nodeX3, nodeY3, "U3", E3);
      drawNode(nodeX3, nodeY5, "U5", E5);

      // --- 2. PLOT DEL OSCILOSCOPIO OPTIMIZADO EN ESCALA ---
      const ox = midX + 25;
      const oy = H - 50;
      const plotWidth = W - ox - 20;
      const plotHeight = H - 85;

      // Pantalla de osciloscopio
      ctx.fillStyle = 'rgba(18, 19, 20, 0.02)'; ctx.fillRect(ox, oy - plotHeight, plotWidth, plotHeight);
      ctx.strokeStyle = 'rgba(18, 19, 20, 0.08)'; ctx.lineWidth = 1.5;
      ctx.strokeRect(ox, oy - plotHeight, plotWidth, plotHeight);

      // Rejilla de división
      ctx.strokeStyle = 'rgba(18, 19, 20, 0.04)';
      for (let i = 1; i < 4; i++) {
        const gy = oy - (plotHeight * (i / 4));
        ctx.beginPath(); ctx.moveTo(ox, gy); ctx.lineTo(ox + plotWidth, gy); ctx.stroke();
      }

      // Escala sintonizada verticalmente (0 a 30)
      ctx.fillStyle = '#121314'; ctx.font = "8px Azeret Mono"; ctx.textAlign = "right";
      ctx.fillText("30 E", ox - 6, oy - plotHeight + 3);
      ctx.fillText("15", ox - 6, oy - plotHeight/2 + 3);
      ctx.fillText("0", ox - 6, oy + 2);

      // Escala horizontal temporal
      ctx.textAlign = "center";
      ctx.fillText("100ms", ox + plotWidth * 0.12, oy + 12);
      ctx.fillText("600ms", ox + plotWidth * 0.62, oy + 12);
      ctx.fillText("1000ms", ox + plotWidth * 0.95, oy + 12);

      // Graficar respuestas neuronales de forma estricta
      const drawCurve = (data: number[], color: string, thickness: number) => {
        ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = thickness;
        ctx.lineJoin = 'round';
        for (let i = 0; i < data.length; i++) {
          const cx = ox + (i / data.length) * plotWidth;
          // Clampear para que no se salga de los límites del recuadro
          const cy = Math.max(oy - plotHeight, Math.min(oy, oy - (data[i] / 30.0) * plotHeight));
          if (i === 0) ctx.moveTo(cx, cy);
          else ctx.lineTo(cx, cy);
        }
        ctx.stroke();
      }

      drawCurve(plotE5, '#D8A499', 3); // Unidad 5 (Negativo - Palo de rosa)
      drawCurve(plotE3, '#121314', 3); // Unidad 3 (Positivo - Obsidian)
      drawCurve(plotR, '#8FA9C4', 1.5); // Entrada r(t) (Azul glaciar)

      neuroAnimationId = requestAnimationFrame(draw);
    }

    draw();
  }

  window.addEventListener('tab-changed', (e: any) => {
    if (e.detail.activeTab === 'neuro') {
      if (neuroAnimationId === null) initNeuroSimulator();
    } else {
      if (neuroAnimationId !== null) {
        cancelAnimationFrame(neuroAnimationId);
        neuroAnimationId = null;
      }
    }
  });

  document.addEventListener('astro:page-load', () => {
    if (activeSimulation === 'neuro') initNeuroSimulator();
  });
</script>