---
// Componente modular premium de Robótica 2DOF con estantería generalizada de 25 slots y control de teclado blindado (TypeScript Safe)
---

<div class="w-full h-full flex flex-col">
  <div class="pb-3 flex justify-between items-center shrink-0 border-b border-bio-text/5 bg-white/40 px-4 rounded-t-2xl">
    <div class="flex items-center gap-2">
      <span class="font-code text-[10px] px-2 py-0.5 bg-bio-green text-white rounded font-bold">PID-CTRL</span>
      <span class="font-code text-[10px] text-bio-green font-bold">SISTEMA MECATRÓNICO DE 2 GRADOS DE LIBERTAD</span>
    </div>
    <div class="flex gap-2">
      <button id="btn-robot-auto" class="px-2.5 py-1 text-[9px] font-code bg-bio-green text-white rounded-md font-bold transition-all shadow-sm">AUTO</button>
      <button id="btn-robot-manual" class="px-2.5 py-1 text-[9px] font-code bg-bio-text/10 text-bio-text rounded-md transition-all">MANUAL</button>
    </div>
  </div>
  <div class="flex-grow bg-bio-bg/40 border border-bio-text/10 rounded-b-2xl overflow-hidden relative min-h-[410px] w-full">
    <canvas id="canvas-robotica" class="w-full h-full cursor-pointer block outline-none" tabindex="0"></canvas>
    <!-- Leyenda interactiva -->
    <div id="robot-control-hint" class="absolute bottom-3 right-3 bg-white/95 px-3 py-2 rounded-lg border border-bio-text/10 shadow-md text-[9px] font-code text-bio-text pointer-events-none hidden max-w-[210px] leading-relaxed z-10">
      Controla el efector final con:<br><strong class="text-bio-green">W, A, S, D</strong> o las <strong class="text-bio-green">Flechas de Dirección</strong>.
    </div>
    <div class="absolute bottom-3 left-3 text-[9px] font-code text-bio-text/45 pointer-events-none z-10" id="robot-status-text">
      STATUS: AUTOMATIC MODE
    </div>
  </div>
</div>

<script>
  // --- VARIABLES DE CONTROL GLOBAL DE ÁMBITO DE MÓDULO ---
  let robotAnimationId: number | null = null;
  let isRunning = false;
  let isAutoModeActive = true; 
  const keysPressed: Record<string, boolean> = {};

  // Canvas y contexto compartido
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;

  // --- REGISTRO DE TECLADO GLOBAL (EVITA EL SCROLL DEL NAVEGADOR) ---
  function handleKeyDown(e: KeyboardEvent) {
    const key = e.key.toLowerCase();
    keysPressed[key] = true;
    
    // Bloquear el scroll por defecto del navegador solo si el robot está en modo manual
    if (!isAutoModeActive) {
      if (["arrowup", "arrowdown", "arrowleft", "arrowright", "w", "a", "s", "d", " "].includes(key)) {
        e.preventDefault(); 
      }
    }
  }

  function handleKeyUp(e: KeyboardEvent) {
    keysPressed[e.key.toLowerCase()] = false;
  }

  // --- SIMULADOR DE ROBÓTICA ---
  function initRobotSimulator() {
    canvas = document.getElementById('canvas-robotica') as HTMLCanvasElement;
    if (!canvas) return;

    ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    // Dimensiones de pantalla y píxeles físicos lógicos
    let W = 0, H = 0;
    let dpr = 1;

    // --- PARÁMETROS GEOMÉTRICOS DEL ROBOT ---
    let L1 = 0; 
    let L2 = 0; 
    let basex = 0;
    let basey = 0;

    // --- VARIABLES DE ESTADO ARTICULAR (ÁNGULOS REALES) ---
    let theta1 = Math.PI / 3;
    let theta2 = -Math.PI / 2; // Forzar codo arriba constante

    // --- COORDENADAS OPERACIONALES CLAVE ---
    let xHome = 0, yHome = 0;
    let xGrab = 0, yGrab = 0;
    
    // --- ESTANTERÍA GENERALIZADA DE 25 SLOTS (5 Filas x 5 Columnas) ---
    const shelfRows = 5;
    const shelfCols = 5;
    const maxShelf = shelfRows * shelfCols; // 25
    
    let shelfX = 0;         // Coordenada horizontal de inicio de la estantería
    let shelfYBase = 0;     // Coordenada vertical base (Ranura inferior)
    const colSpacing = 16;  // Separación horizontal entre columnas
    const rowSpacing = 22;  // Separación vertical entre niveles

    // Algoritmo matemático para indexar coordenadas sin valores acoplados estáticamente
    function getShelfSlotCoordinates(index: number) {
      const row = Math.floor(index / shelfCols); // De 0 a 4 (de abajo hacia arriba)
      const col = index % shelfCols;             // De 0 a 4 (de izquierda a derecha)
      return {
        x: shelfX + col * colSpacing,
        y: shelfYBase - row * rowSpacing
      };
    }

    // --- SETPOINT VS VARIABLE DE PROCESO (FÍSICA DE SEGUNDO ORDEN) ---
    let targetX = 0, targetY = 0; 
    let currentX = 0, currentY = 0; 
    
    let vx = 0, vy = 0;
    const k_spring = 0.045; 
    const c_damping = 0.14; 

    const historyLength = 100;
    const setpointHistory: number[] = Array(historyLength).fill(0);
    const responseHistory: number[] = Array(historyLength).fill(0);

    // --- ESTADO DE LA PELOTA ---
    let ball = {
      x: 0,
      y: 0,
      radius: 7.5, // Más compacto para caber estéticamente en los 25 slots
      active: true,
      isStaticAtGrab: false
    };

    let grabbed = false;
    let shelfBalls: {x: number, y: number}[] = []; 
    
    // --- MÁQUINA DE ESTADOS INDUSTRIAL ---
    const STATE_HOME = 0;       
    const STATE_APPROACH = 1;   
    const STATE_DELIVER = 2;    
    const STATE_GO_HOME = 3;    
    let currentState = STATE_HOME;

    // --- ADAPTACIÓN DE TAMAÑO Y CRISPNESS (ELIMINA EL PIXELADO) ---
    function resize() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      dpr = window.devicePixelRatio || 1;
      
      const width = rect.width || canvas.parentElement?.clientWidth || 600;
      const height = rect.height || canvas.parentElement?.clientHeight || 410;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      
      ctx.resetTransform();
      ctx.scale(dpr, dpr);
      
      W = width;
      H = height;

      // Proporciones robustas del robot
      L1 = H * 0.38; 
      L2 = H * 0.30; 
      basex = W * 0.46; // Desplazado ligeramente para acomodar las 5 columnas a la derecha
      basey = H - 55;

      xHome = basex;
      yHome = basey - H * 0.35;

      xGrab = basex + W * 0.16; 
      yGrab = basey - 12;

      // Ubicación base de la estantería de 25 slots elevada en la parte derecha
      shelfX = basex + W * 0.18;
      shelfYBase = basey - H * 0.20;

      if (currentState === STATE_HOME && isAutoModeActive) {
        targetX = xHome; targetY = yHome;
        if (!grabbed) {
          ball.x = W;
          ball.y = yGrab;
        }
      }
    }

    // --- INTERRUPTORES DE MODO ASOCIADOS A VARIABLE COMPARTIDA ---
    document.getElementById('btn-robot-auto')?.addEventListener('click', (e) => {
      isAutoModeActive = true;
      document.getElementById('robot-control-hint')?.classList.add('hidden');
      (e.target as HTMLElement).classList.replace('bg-bio-text/10', 'bg-bio-green');
      (e.target as HTMLElement).classList.add('text-white');
      document.getElementById('btn-robot-manual')?.classList.replace('bg-bio-green', 'bg-bio-text/10');
      document.getElementById('btn-robot-manual')?.classList.remove('text-white');
      document.getElementById('robot-status-text')!.innerText = "STATUS: AUTOMATIC MODE";
      
      grabbed = false; 
      ball.x = W; 
      ball.active = true; 
      ball.isStaticAtGrab = false;
      currentState = STATE_HOME;
      targetX = xHome; targetY = yHome;
      currentX = xHome; currentY = yHome;
      vx = 0; vy = 0;
    });

    document.getElementById('btn-robot-manual')?.addEventListener('click', (e) => {
      isAutoModeActive = false;
      document.getElementById('robot-control-hint')?.classList.remove('hidden');
      (e.target as HTMLElement).classList.replace('bg-bio-text/10', 'bg-bio-green');
      (e.target as HTMLElement).classList.add('text-white');
      document.getElementById('btn-robot-auto')?.classList.replace('bg-bio-green', 'bg-bio-text/10');
      document.getElementById('btn-robot-auto')?.classList.remove('text-white');
      document.getElementById('robot-status-text')!.innerText = "STATUS: KEYBOARD MANUAL MODE [WASD / ARROWS]";
      
      grabbed = false;
      ball.x = xGrab;
      ball.active = true;
      ball.isStaticAtGrab = true;
      targetX = xHome; targetY = yHome;
      currentX = xHome; currentY = yHome;
      vx = 0; vy = 0;
    });

    // --- MATEMÁTICAS DE CINEMÁTICA ---
    function getDirectKinematics(t1Val: number, t2Val: number) {
      const xLocal = L1 * Math.cos(t1Val) + L2 * Math.cos(t1Val + t2Val);
      const yLocal = L1 * Math.sin(t1Val) + L2 * Math.sin(t1Val + t2Val);
      return { x: basex + xLocal, y: basey - yLocal };
    }

    function solveInverseKinematics(xd: number, yd: number) {
      const px = xd - basex;
      const py = basey - yd; 

      let cosTheta2 = (px * px + py * py - L1 * L1 - L2 * L2) / (2 * L1 * L2);
      cosTheta2 = Math.max(-0.9999, Math.min(0.9999, cosTheta2));
      
      const t2Target = -Math.acos(cosTheta2);
      const t1Target = Math.atan2(py, px) - Math.atan2(L2 * Math.sin(t2Target), L1 + L2 * Math.cos(t2Target));

      theta1 += (t1Target - theta1) * 0.15;
      theta2 += (t2Target - theta2) * 0.15;
    }

    // --- BUCLE DE SIMULACIÓN ---
    function draw() {
      // Usar constante local 'c' para garantizarle a TS que context nunca será null
      const c = ctx;
      if (!c || !isRunning) return;

      c.clearRect(0, 0, W, H);

      // --- 1. FONDO ESTÉTICO E INDUSTRIAL ---
      c.strokeStyle = 'rgba(18, 19, 20, 0.03)'; c.lineWidth = 1;
      const stepGrid = 25;
      for (let x = 0; x < W; x += stepGrid) {
        c.beginPath(); c.moveTo(x, 0); c.lineTo(x, H); c.stroke();
      }
      for (let y = 0; y < H; y += stepGrid) {
        c.beginPath(); c.moveTo(0, y); c.lineTo(W, y); c.stroke();
      }

      // Envolvente radial del espacio de trabajo
      c.strokeStyle = 'rgba(143, 169, 196, 0.08)'; c.lineWidth = 1.5;
      c.setLineDash([4, 4]);
      c.beginPath(); c.arc(basex, basey, L1 + L2, Math.PI, 0); c.stroke();
      c.setLineDash([]);

      // --- 2. MODELADO FÍSICO DE CONTROL (PID DE SEGUNDO ORDEN) ---
      const ax = k_spring * (targetX - currentX) - c_damping * vx;
      const ay = k_spring * (targetY - currentY) - c_damping * vy;
      vx += ax; vy += ay;
      currentX += vx; currentY += vy;

      setpointHistory.push(targetX); setpointHistory.shift();
      responseHistory.push(currentX); responseHistory.shift();

      // --- 3. PROCESAR LÓGICA AUTOMÁTICA VS MANUAL ---
      const currentGripper = getDirectKinematics(theta1, theta2);

      if (isAutoModeActive) {
        switch (currentState) {
          case STATE_HOME:
            targetX = xHome; targetY = yHome;
            ball.isStaticAtGrab = false;

            if (ball.active) {
              if (ball.x > xGrab) {
                ball.x -= 2.0; 
              } else {
                ball.x = xGrab;
                ball.isStaticAtGrab = true; 
                currentState = STATE_APPROACH;
              }
            }
            break;

          case STATE_APPROACH:
            targetX = xGrab; targetY = yGrab;
            const dToBall = Math.sqrt(Math.pow(currentGripper.x - ball.x, 2) + Math.pow(currentGripper.y - ball.y, 2));
            if (dToBall < 6) {
              grabbed = true;
              currentState = STATE_DELIVER;
            }
            break;

          case STATE_DELIVER:
            // Obtener coordenadas de entrega calculadas algorítmicamente para la matriz 5x5
            const activeSlot = getShelfSlotCoordinates(shelfBalls.length);
            targetX = activeSlot.x;
            targetY = activeSlot.y;

            ball.x = currentGripper.x;
            ball.y = currentGripper.y;

            const dToShelf = Math.sqrt(Math.pow(ball.x - targetX, 2) + Math.pow(ball.y - targetY, 2));
            if (dToShelf < 6) {
              shelfBalls.push({ x: targetX, y: targetY });
              grabbed = false;
              ball.active = false;

              // Reiniciar al completar los 25 slots de la estantería
              if (shelfBalls.length >= maxShelf) {
                setTimeout(() => { shelfBalls = []; }, 1000);
              }
              currentState = STATE_GO_HOME;
            }
            break;

          case STATE_GO_HOME:
            targetX = xHome; targetY = yHome;
            const dToHome = Math.sqrt(Math.pow(currentGripper.x - xHome, 2) + Math.pow(currentGripper.y - yHome, 2));
            if (dToHome < 6) {
              setTimeout(() => {
                ball.x = W;
                ball.y = yGrab;
                ball.active = true;
                ball.isStaticAtGrab = false;
                currentState = STATE_HOME;
              }, 400);
            }
            break;
        }
      } else {
        // --- CONTROL MANUAL DE COORDENADAS ---
        const step = 4;
        if (keysPressed['w'] || keysPressed['arrowup']) targetY -= step;
        if (keysPressed['s'] || keysPressed['arrowdown']) targetY += step;
        if (keysPressed['a'] || keysPressed['arrowleft']) targetX -= step;
        if (keysPressed['d'] || keysPressed['arrowright']) targetX += step;

        const distFromBase = Math.sqrt(Math.pow(targetX - basex, 2) + Math.pow(targetY - basey, 2));
        const maxRange = (L1 + L2) - 6;
        const minRange = Math.abs(L1 - L2) + 16;

        if (distFromBase > maxRange) {
          const angle = Math.atan2(targetY - basey, targetX - basex);
          targetX = basex + maxRange * Math.cos(angle);
          targetY = basey + maxRange * Math.sin(angle);
        } else if (distFromBase < minRange) {
          const angle = Math.atan2(targetY - basey, targetX - basex);
          targetX = basex + minRange * Math.cos(angle);
          targetY = basey + minRange * Math.sin(angle);
        }

        if (targetY > yGrab) targetY = yGrab;

        const dToBallManual = Math.sqrt(Math.pow(currentGripper.x - ball.x, 2) + Math.pow(currentGripper.y - ball.y, 2));
        if (dToBallManual < 12 && ball.active && !grabbed) {
          grabbed = true;
        }

        if (grabbed) {
          ball.x = currentGripper.x;
          ball.y = currentGripper.y;

          // Autodepósito por aproximación al slot activo en manual
          const targetSlotManual = getShelfSlotCoordinates(shelfBalls.length);
          const distToShelfSlot = Math.sqrt(Math.pow(ball.x - targetSlotManual.x, 2) + Math.pow(ball.y - targetSlotManual.y, 2));
          if (distToShelfSlot < 25) {
            shelfBalls.push({ x: targetSlotManual.x, y: targetSlotManual.y });
            grabbed = false;
            ball.active = false;

            if (shelfBalls.length >= maxShelf) {
              setTimeout(() => { shelfBalls = []; }, 1000);
            }
            setTimeout(() => {
              ball.x = xGrab; ball.y = yGrab; ball.active = true;
            }, 1000);
          }
        }

        // Puntero de consigna visual
        c.strokeStyle = 'rgba(216, 164, 153, 0.45)'; c.lineWidth = 1;
        c.beginPath(); c.arc(targetX, targetY, 7, 0, Math.PI * 2); c.stroke();
      }

      solveInverseKinematics(currentX, currentY);

      // --- 4. RENDERIZADO VECTORIAL DE LA ESTANTERÍA DE 25 SLOTS (5x5) ---
      c.strokeStyle = '#8C7870'; c.lineWidth = 3;
      c.beginPath();
      
      // Poste vertical izquierdo
      c.moveTo(shelfX - 8, shelfYBase + 12);
      c.lineTo(shelfX - 8, shelfYBase - (shelfRows - 1) * rowSpacing - 10);
      
      // Poste vertical derecho
      c.moveTo(shelfX + (shelfCols - 1) * colSpacing + 8, shelfYBase + 12);
      c.lineTo(shelfX + (shelfCols - 1) * colSpacing + 8, shelfYBase - (shelfRows - 1) * rowSpacing - 10);
      c.stroke();

      // Bandejas horizontales (5 niveles)
      c.lineWidth = 2;
      for (let r = 0; r < shelfRows; r++) {
        const sy = shelfYBase - r * rowSpacing + 8;
        c.beginPath();
        c.moveTo(shelfX - 12, sy);
        c.lineTo(shelfX + (shelfCols - 1) * colSpacing + 12, sy);
        c.stroke();
      }

      // Dibujar las pelotas entregadas en sus coordenadas exactas de la malla
      shelfBalls.forEach((b, idx) => {
        const slot = getShelfSlotCoordinates(idx);
        c.fillStyle = '#D8A499';
        c.beginPath();
        c.arc(slot.x, slot.y, ball.radius, 0, Math.PI * 2);
        c.fill();
      });

      // Dibujar la pelota en la banda o sujeta
      if (ball.active && (!grabbed || !isAutoModeActive)) {
        c.fillStyle = '#D8A499';
        c.beginPath();
        c.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
        c.fill();
      }

      // --- 5. RENDERIZADO DEL BRAZO ROBÓTICO CODO ARRIBA ---
      const j1x = basex + L1 * Math.cos(theta1);
      const j1y = basey - L1 * Math.sin(theta1); 
      
      const j2x = j1x + L2 * Math.cos(theta1 + theta2);
      const j2y = j1y - L2 * Math.sin(theta1 + theta2);

      // Eslabón 1 (Verde salvia)
      c.lineWidth = 13; c.lineCap = 'round';
      c.strokeStyle = '#4E5E52';
      c.beginPath(); c.moveTo(basex, basey); c.lineTo(j1x, j1y); c.stroke();

      // Eslabón 2 (Azul glaciar)
      c.lineWidth = 10;
      c.strokeStyle = '#8FA9C4';
      c.beginPath(); c.moveTo(j1x, j1y); c.lineTo(j2x, j2y); c.stroke();

      // Juntas articulares (Puntos de pivote)
      c.fillStyle = '#F4F1EA';
      c.beginPath(); c.arc(j1x, j1y, 4.5, 0, Math.PI * 2); c.fill();
      c.beginPath(); c.arc(j2x, j2y, 4.5, 0, Math.PI * 2); c.fill();

      // Base estructural
      c.fillStyle = '#4E5E52';
      c.beginPath(); c.arc(basex, basey, 14, Math.PI, 0); c.fill();

      // Efector final / Gripper
      c.strokeStyle = grabbed ? '#D8A499' : '#121314'; 
      c.lineWidth = 4;
      c.beginPath(); c.moveTo(j2x, j2y); c.lineTo(j2x, j2y + 12); c.stroke();

      // --- 6. OSCILOSCOPIO DINÁMICO TÉCNICO (SINTONIZACIÓN PID) ---
      const plotX = W - 170;
      const plotY = 25;
      const plotW = 150;
      const plotH = 65;

      c.fillStyle = 'rgba(18, 19, 20, 0.02)'; c.fillRect(plotX, plotY, plotW, plotH);
      c.strokeStyle = 'rgba(18, 19, 20, 0.1)'; c.lineWidth = 1;
      c.strokeRect(plotX, plotY, plotW, plotH);

      c.strokeStyle = 'rgba(18, 19, 20, 0.03)';
      c.beginPath();
      c.moveTo(plotX + plotW/2, plotY); c.lineTo(plotX + plotW/2, plotY + plotH);
      c.moveTo(plotX, plotY + plotH/2); c.lineTo(plotX + plotW, plotY + plotH/2);
      c.stroke();

      const drawScopeCurve = (history: number[], color: string, thickness: number) => {
        c.beginPath(); c.strokeStyle = color; c.lineWidth = thickness;
        c.lineJoin = 'round';
        
        const minVal = basex - 120;
        const maxVal = basex + 120;
        const range = maxVal - minVal;

        for (let i = 0; i < history.length; i++) {
          const cx = plotX + (i / (history.length - 1)) * plotW;
          const norm = (history[i] - minVal) / range;
          const cy = plotY + plotH - (norm * plotH);
          if (i === 0) c.moveTo(cx, cy);
          else c.lineTo(cx, cy);
        }
        c.stroke();
      }

      drawScopeCurve(setpointHistory, 'rgba(143, 169, 196, 0.5)', 1.5); 
      drawScopeCurve(responseHistory, '#4E5E52', 1.8); 

      c.fillStyle = '#121314'; c.font = "8px Azeret Mono"; c.textAlign = "left";
      c.fillText("X-AXIS STEP RESPONSE", plotX, plotY - 6);

      robotAnimationId = requestAnimationFrame(draw);
    }

    // Adaptar y re-escalar de forma síncrona ante eventos de redimensión de pantalla
    window.removeEventListener('resize', resize);
    window.addEventListener('resize', resize);
    resize();
    
    // Coordenadas lógicas iniciales
    currentX = xHome; currentY = yHome;
    draw();
  }

  // --- CONTROL EXPLICITO DE INICIALIZACION SEGURO ---
  function startSimulator() {
    stopSimulator(); // Limpiar residuos antes de iniciar
    
    // Un retardo de 50ms permite que el layout CSS de Tailwind se asiente antes de medir
    setTimeout(() => {
      initRobotSimulator();
      
      // Suscribir escuchas globales de teclado directamente al objeto window para máxima fiabilidad
      window.removeEventListener('keydown', handleKeyDown);
      window.addEventListener('keydown', handleKeyDown);
      window.removeEventListener('keyup', handleKeyUp);
      window.addEventListener('keyup', handleKeyUp);
    }, 50);
  }

  function stopSimulator() {
    isRunning = false;
    if (robotAnimationId !== null) {
      cancelAnimationFrame(robotAnimationId);
      robotAnimationId = null;
    }
    // Desuscribir los listeners globales al salir de la pestaña para evitar fugas de memoria
    window.removeEventListener('keydown', handleKeyDown);
    window.removeEventListener('keyup', handleKeyUp);
  }

  // Suspender renderizado cuando la pestaña no es la activa
  window.addEventListener('tab-changed', (e: any) => {
    if (e.detail.activeTab === 'robotica') {
      startSimulator();
    } else {
      stopSimulator();
    }
  });

  document.addEventListener('astro:page-load', () => {
    if ((window as any).activeSimulation === 'robotica') {
      startSimulator();
    } else {
      stopSimulator();
    }
  });
</script>