---
import LayoutBase from '../layouts/LayoutBase.astro';
import FondoTuring from '../components/FondoTuring.astro';
---

<LayoutBase title="Sobre mí | Portfolio">
  <FondoTuring />
  <section class="flex flex-col items-center justify-center min-h-[80vh] px-6 text-center">
    <h1 class="text-4xl font-bold text-cyan-400 mb-4">Sobre mí</h1>
    <p class="text-gray-400 max-w-xl">
      Bienvenido a mi portfolio de Ingeniería Mecatrónica. Aquí encontrarás mis proyectos,
      publicaciones y espacio personal.
    </p>
  </section>
</LayoutBase>
