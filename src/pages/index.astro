---
import LayoutBase from '../layouts/LayoutBase.astro';
import FondoTuring from '../components/FondoTuring.astro';

// Importación de tus tres simuladores modulares de alto rendimiento
import SimuladorRobotica from '../components/SimuladorRobotica.astro';
import SimuladorNeuro from '../components/SimuladorNeuro.astro';
import SimuladorCuantica from '../components/SimuladorCuantica.astro';
---

<LayoutBase title="Sobre mí">
  <!-- Fondo matemático interactivo bio-inspirado Verde Salvia -->
  <FondoTuring />

  <div class="space-y-20 animate-[fadeIn_0.6s_ease-out]">
    
    <!-- SECCIÓN HERO: El Manifiesto y la Ingeniería Balanceada -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center min-h-[70vh] pt-4 md:pt-8">
      
      <!-- Bloque Izquierdo: Pitch Profesional & Artístico (7 Columnas) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-bio-green/10 text-bio-green rounded-full border border-bio-green/20">
          <span class="h-1.5 w-1.5 rounded-full bg-bio-rose animate-pulse"></span>
          <span class="font-code text-[10px] font-bold tracking-wider uppercase">Ingeniería & Diseño Bio-Inspirado</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl tracking-tight text-bio-text font-tech leading-none">
          No soy un Da Vinci, <br class="hidden md:inline" />
          no soy un Picasso, <br />
          <span class="text-bio-green underline decoration-bio-rose decoration-wavy underline-offset-4">pero soy feliz creando.</span>
        </h1>
        
        <p class="text-base md:text-lg text-bio-text/85 leading-relaxed font-sans max-w-2xl">
          Como <span class="font-bold text-bio-green">Ingeniero Mecatrónico especialista en Inteligencia Artificial</span>, mi núcleo profesional radica en el diseño de sistemas dinámicos de control, automatización industrial y robótica autónoma. No concibo la ingeniería como una estructura rígida y fría; para mí, el <span class="font-bold text-bio-blue">desarrollo Frontend</span> es mi pincel tecnológico. Es el espacio donde convergen la matemática y la estética para dar color, movimiento y un sentido intuitivo a las ideas complejas.
        </p>

        <div class="border-l-3 border-bio-rose pl-4 py-1.5 bg-white/30 backdrop-blur-sm rounded-r-xl max-w-xl">
          <p class="text-xs md:text-sm italic text-bio-brown font-medium leading-relaxed">
            "Nunca me canso de mirar el mundo con otros ojos, de redescubrir las leyes físicas del universo y de explorar nuevas perspectivas teóricas para explicárselas de manera didáctica a los demás."
          </p>
        </div>

        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/portfolio/proyectos/" class="px-5 py-3 bg-bio-green hover:bg-bio-green/90 text-bio-bg font-code text-xs font-bold rounded-xl shadow-md hover:scale-[1.02] transition-all flex items-center gap-2">
            Ver mis Proyectos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/portfolio/divulgacion/" class="px-5 py-3 border border-bio-text/20 hover:bg-bio-text/5 text-bio-text font-code text-xs font-bold rounded-xl transition-all">
            Divulgación Científica
          </a>
        </div>
      </div>

      <!-- Bloque Derecho: Consola de Telemetría sin espacios vacíos (4 Columnas) -->
      <div class="lg:col-span-4 bg-white/60 backdrop-blur-md p-6 rounded-2xl border border-bio-text/10 shadow-sm relative overflow-hidden flex flex-col justify-between min-h-[350px]">
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:12px_12px]"></div>
        
        <div class="z-10 flex flex-col h-full justify-between">
          <div class="flex justify-between items-center border-b border-bio-text/10 pb-3 mb-4">
            <span class="font-code text-[10px] text-bio-text/50">PROFILE // TELEMETRY_CORE_01</span>
            <span class="text-[9px] font-code bg-bio-green/20 text-bio-green px-2 py-0.5 rounded font-bold animate-pulse" id="terminal-status">BOOTING</span>
          </div>

          <div class="flex-grow flex flex-col justify-between">
            <div id="telemetry-terminal" class="font-code text-[11px] text-bio-green leading-relaxed whitespace-pre-line min-h-[180px]">
              <!-- Texto inyectado dinámicamente -->
            </div>
            
            <div class="flex justify-between items-center border-t border-bio-text/10 pt-3 mt-4 text-[8px] font-code text-bio-text/40">
              <span>BAUD_RATE: 115200 bps</span>
              <span>SYSTEM_CPU: OPTIMAL</span>
            </div>
          </div>
        </div>
      </div>

    </section>

    <!-- SECCIÓN INTERACTIVA: El Tablero del Aprendiz con Pestañas Horizontales -->
    <section id="tablero-aprendiz" class="space-y-8 relative z-20 bg-bio-bg border-t border-bio-text/10 pt-16 pb-12 w-full">
      <div class="max-w-4xl space-y-2">
        <h2 class="text-3xl font-tech text-bio-text tracking-tight">El Tablero del Aprendiz</h2>
        <p class="text-sm md:text-base text-bio-text/70 font-sans">
          La ingeniería se comprende construyéndola. Presiona cualquiera de los tres paneles de descripción horizontal para desplegar su laboratorio de simulación interactiva en tiempo real.
        </p>
      </div>

      <!-- 1. BLOQUE DE PANELES DE DESCRIPCIÓN EN GRID HORIZONTAL (Columna al lado de columna) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Tarjeta Horizontal 1: Robótica -->
        <div id="panel-desc-robotica" class="panel-card cursor-pointer p-5 rounded-2xl border border-bio-text/10 bg-white/40 transition-all hover:bg-white/60 hover:shadow-sm" data-tab="robotica">
          <div class="flex justify-between items-center mb-2">
            <span class="font-code text-[10px] text-bio-green font-bold uppercase">01 // AUTOMATIZACIÓN & CONTROL</span>
            <span class="text-xs">⚙️</span>
          </div>
          <h3 class="font-tech text-base text-bio-text mb-2">Manipulador 2DOF & Cinemática</h3>
          <p class="text-xs text-bio-text/70 leading-relaxed font-sans">
            La robótica representa la materialización física del control. Me apasiona el diseño cinemático, la sintonización de lazo cerrado y el desarrollo de trayectorias óptimas para brazos articulados capaces de manipular su entorno de forma autónoma.
          </p>
        </div>

        <!-- Tarjeta Horizontal 2: Neuro-Simulación -->
        <div id="panel-desc-neuro" class="panel-card cursor-pointer p-5 rounded-2xl border border-bio-text/10 bg-white/40 transition-all hover:bg-white/60 hover:shadow-sm" data-tab="neuro">
          <div class="flex justify-between items-center mb-2">
            <span class="font-code text-[10px] text-bio-rose font-bold uppercase">02 // SISTEMAS DINÁMICOS BIO</span>
            <span class="text-xs">🧬</span>
          </div>
          <h3 class="font-tech text-base text-bio-text mb-2">Circuitos & Neuro-Simulación</h3>
          <p class="text-xs text-bio-text/70 leading-relaxed font-sans">
            La biología ha resuelto el procesamiento paralelo de forma óptima. Modelar dinámicas de conductancia por medio de ecuaciones diferenciales ordinarias (EDO) permite emular sensores neuronales integradores de derivada que detectan flancos de activación transitoria.
          </p>
        </div>

        <!-- Tarjeta Horizontal 3: Física Teórica -->
        <div id="panel-desc-cuantica" class="panel-card cursor-pointer p-5 rounded-2xl border border-bio-text/10 bg-white/40 transition-all hover:bg-white/60 hover:shadow-sm" data-tab="cuantica">
          <div class="flex justify-between items-center mb-2">
            <span class="font-code text-[10px] text-bio-blue font-bold uppercase">03 // CURIOSIDAD CUÁNTICA</span>
            <span class="text-xs">🌌</span>
          </div>
          <h3 class="font-tech text-base text-bio-text mb-2">Fascinaciones Teóricas & Ondas</h3>
          <p class="text-xs text-bio-text/70 leading-relaxed font-sans">
            La física moderna redefine lo que entendemos por información. Modelar la dualidad onda-partícula y el colapso de función de onda en el experimento de la doble rendija es un recordatorio gráfico de la potencia de procesamiento de estados complejos.
          </p>
        </div>

      </div>

      <!-- 2. CONTENEDOR DE SIMULACIONES (INICIALMENTE DORMIDO) -->
      <div class="w-full bg-white/80 backdrop-blur-md p-6 rounded-2xl border border-bio-text/10 shadow-sm flex flex-col min-h-[500px] justify-center" id="simulation-container">
        
        <!-- ESTADO DORMIDO / PLACEHOLDER (Se muestra en la carga inicial) -->
        <div id="simulation-placeholder" class="text-center py-16 space-y-4 animate-[fadeIn_0.5s_ease-out]">
          <div class="mx-auto w-16 h-16 rounded-full bg-bio-green/10 flex items-center justify-center text-bio-green text-2xl animate-pulse">
            🔬
          </div>
          <h3 class="font-tech text-xl text-bio-text">Laboratorios Científicos en Espera</h3>
          <p class="text-xs md:text-sm text-bio-text/60 max-w-md mx-auto font-sans">
            Haz clic en cualquiera de las tres disciplinas de arriba para iniciar la inyección de parámetros físicos en el lienzo y ver la simulación interactiva.
          </p>
          <div class="pt-2">
            <!-- Sutil osciloscopio decorativo que indica que el sistema está listo -->
            <div class="flex justify-center gap-1.5 items-center">
              <span class="h-1.5 w-1.5 bg-bio-green/30 rounded-full animate-bounce"></span>
              <span class="h-2.5 w-1.5 bg-bio-green/40 rounded-full animate-bounce [animation-delay:0.2s]"></span>
              <span class="h-4 w-1.5 bg-bio-green/60 rounded-full animate-bounce [animation-delay:0.4s]"></span>
              <span class="h-2.5 w-1.5 bg-bio-green/40 rounded-full animate-bounce [animation-delay:0.6s]"></span>
              <span class="h-1.5 w-1.5 bg-bio-green/30 rounded-full animate-bounce [animation-delay:0.8s]"></span>
            </div>
          </div>
        </div>

        <!-- CONTENEDORES MODULARES INDEPENDIENTES (Se revelan bajo demanda) -->
        <div id="tab-content-robotica" class="tab-content hidden w-full h-full">
          <SimuladorRobotica />
        </div>

        <div id="tab-content-neuro" class="tab-content hidden w-full h-full">
          <SimuladorNeuro />
        </div>

        <div id="tab-content-cuantica" class="tab-content hidden w-full h-full">
          <SimuladorCuantica />
        </div>

      </div>
    </section>

  </div>
</LayoutBase>

<script is:inline>
  // Inicializamos la pestaña activa como nula al inicio (Estado Dormido)
  window.activeSimulation = null;
</script>

<script>
  function initTabsAndTerminal() {
    const panels = document.querySelectorAll('.panel-card');
    const contents = document.querySelectorAll('.tab-content');
    const placeholder = document.getElementById('simulation-placeholder');
    const container = document.getElementById('simulation-container');

    // --- 1. SELECCIÓN HORIZONTAL DE TABS ---
    panels.forEach(panel => {
      panel.addEventListener('click', () => {
        const tabId = panel.getAttribute('data-tab')!;
        (window as any).activeSimulation = tabId;

        // Ocultar placeholder
        if (placeholder) placeholder.classList.add('hidden');

        panels.forEach(p => {
          p.classList.remove('border-2', 'border-bio-green', 'bg-white/95', 'shadow-md');
          p.classList.add('border-bio-text/10', 'bg-white/40');
        });

        panel.classList.add('border-2', 'border-bio-green', 'bg-white/95', 'shadow-md');
        panel.classList.remove('border-bio-text/10', 'bg-white/40');

        contents.forEach(content => content.classList.add('hidden'));

        const targetContent = document.getElementById(`tab-content-${tabId}`);
        if (targetContent) {
          targetContent.classList.remove('hidden');
          targetContent.classList.add('animate-[fadeIn_0.3s_ease-out]');
          
          // Despachar evento para notificar al script del módulo modular que inicie su renderizado
          window.dispatchEvent(new CustomEvent('tab-changed', { detail: { activeTab: tabId } }));
          window.dispatchEvent(new Event('resize')); 
        }
      });
    });

    // --- 2. CONTROL DEL PAUSADO DE TURING ---
    const tablero = document.getElementById('tablero-aprendiz');
    if (tablero) {
      const observer = new IntersectionObserver((entries) => {
        const turingCanvas = document.getElementById('turing-bg-canvas');
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (turingCanvas) turingCanvas.style.opacity = '0';
            (window as any).pauseTuring = true;
          } else {
            if (turingCanvas) turingCanvas.style.opacity = '0.28';
            (window as any).pauseTuring = false;
          }
        });
      }, { threshold: 0.1 });
      observer.observe(tablero);
    }

    // --- 3. TELEMETRÍA DE UN SOLO CICLO (TYPEWRITER) ---
    const terminal = document.getElementById('telemetry-terminal');
    const statusText = document.getElementById('terminal-status');
    if (!terminal || terminal.dataset.booted === "true") return;
    terminal.dataset.booted = "true";

    const bootLogs = [
      "> init_telemetry_system...",
      "> enlazando sensores de hardware... [OK]",
      "> cargando variables de estado PID...",
      "> inicializando kernel matemático...",
      "> enlace estático completado."
    ];

    const profileData = `> Nombre: David Caicedo Samboni (21 años)
> Profesión: Ingeniero Mecatrónico
> Especialidad: Inteligencia Artificial
> Habilidades Físicas: Automatización, Robótica, Control
> Habilidades Lógicas: Deep Learning, Simulaciones EDO
> Canal Creativo: Frontend & UI/UX Design
> Estado: ONLINE y preparado para compilar ideas.`;

    async function sleep(ms: number) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }

    async function runTypewriter() {
      if (statusText) statusText.innerText = "BOOTING";
      for (const line of bootLogs) {
        terminal!.innerHTML += line + "<br>";
        await sleep(450);
      }
      await sleep(500);

      terminal!.innerHTML = "> clear<br>";
      await sleep(200);
      terminal!.innerHTML = "";
      if (statusText) {
        statusText.innerText = "ONLINE";
        statusText.classList.remove('bg-bio-green/20', 'text-bio-green');
        statusText.classList.add('bg-bio-blue/20', 'text-bio-blue');
      }

      let currentHTML = "";
      const lines = profileData.split('\n');
      
      for (const line of lines) {
        for (const char of line) {
          currentHTML += char;
          terminal!.innerHTML = currentHTML + '<span class="animate-pulse">█</span>';
          await sleep(12);
        }
        currentHTML += "<br>";
        terminal!.innerHTML = currentHTML + '<span class="animate-pulse">█</span>';
        await sleep(100);
      }
      
      terminal!.innerHTML = currentHTML + '<span class="animate-pulse text-bio-blue">█</span>';
    }

    runTypewriter();
  }

  document.addEventListener('astro:page-load', () => {
    initTabsAndTerminal();
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>