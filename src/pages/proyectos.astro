---
import LayoutBase from '../layouts/LayoutBase.astro';
import { Image } from 'astro:assets';

// Importación segura de recursos visuales desde src/assets/projects/
import imgPeter from '../assets/projects/peter.png';
import imgIotCnc from '../assets/projects/iot-cnc.png';
import imgSalli from '../assets/projects/salli.png';
import imgNeuroEmotion from '../assets/projects/neuro-emotion.png';

// =====================================================================
// SISTEMA RECURSIVO DE PROYECTOS (CMS LOCAL)
// =====================================================================
const proyectosData = [
  {
    id: "peter",
    titulo: "Plataforma Híbrida Multimodal Peter",
    subtitulo: "Arquitectura de control autónomo e IA Bioinspirada Embebida para locomoción híbrida (cuadrúpeda-rodante).",
    fecha: "2026",
    rol: "Arquitecto de Control Autónomo",
    tags: ["ROS 2", "Edge AI", "C++", "Gazebo"],
    imagenObjeto: imgPeter,
    colorClase: "bio-rose",
    colorHex: "#D8A499",
    detallesHTML: `
      <div class="space-y-6">
        <div>
          <h4 class="font-tech text-lg text-bio-green mb-2 border-b border-bio-text/10 pb-1 uppercase tracking-wider">Resumen Ejecutivo & Liderazgo</h4>
          <p class="font-sans text-xs md:text-sm text-bio-text/80 leading-relaxed">
            Conceptualización e ingeniería de una plataforma de locomoción multimodal híbrida. Ejecución de 60 ensayos continuos de validación con inyección de ruido estocástico uniforme ($S = 0 \\to 4$), logrando una tasa de éxito operativa del 100% en evasión de obstáculos vectoriales y consolidando la transición morfológica con una fiabilidad paramétrica del 95%.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-rose block uppercase">Métrica Clave // Latencia</span>
            <span class="font-tech text-3xl font-bold text-bio-text">47 ms</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Bucle cerrado de control de alta frecuencia sin cuellos de botella en cache.</p>
          </div>
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-green block uppercase">Precisión // Actitud</span>
            <span class="font-tech text-3xl font-bold text-bio-text">± 0.54°</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Error acotado de Roll RMS y ±1.06° de Pitch RMS sobre ruido topográfico.</p>
          </div>
        </div>

        <div>
          <h4 class="font-tech text-base text-bio-green mb-2 uppercase">Leyes de Control y Selección Neuronal</h4>
          <p class="font-sans text-xs text-bio-text/75 leading-relaxed mb-2">
            La resolución de conflictos entre estímulos se rige por ecuaciones diferenciales de integración con fugas (leaky-integrator) inspiradas en la topología de los ganglios basales para actualización de tasa neuronal:
          </p>
          <div class="p-3 bg-black/5 rounded-lg border border-bio-text/10 font-code text-xs text-bio-green text-center">
            τ · (da_i / dt) = -a_i + max(0, Σ W_ij · a_j + I_i - θ)
          </div>
        </div>
      </div>
    `,
    github: "#",
    video: "#"
  },
  {
    id: "iot-cnc",
    titulo: "IoT CNC PCB Monitor",
    subtitulo: "Plataforma de monitoreo industrial distribuida mediante Edge AI y orquestación Serverless.",
    fecha: "2025",
    rol: "Lead Systems Architect & Embedded Firmware Engineer",
    tags: ["Azure IoT", "ESP32", "TinyML", "MQTT"],
    imagenObjeto: imgIotCnc,
    colorClase: "bio-blue",
    colorHex: "#8FA9C4",
    detallesHTML: `
      <div class="space-y-6">
        <div>
          <h4 class="font-tech text-lg text-bio-green mb-2 border-b border-bio-text/10 pb-1 uppercase tracking-wider">Impacto Técnico & Cloud</h4>
          <p class="font-sans text-xs md:text-sm text-bio-text/80 leading-relaxed">
            Ingeniería de extremo a extremo de un sistema distribuido de análisis industrial. Diseñado mediante desacoplamiento estricto de microservicios con despliegues automatizados bajo el paradigma de Infraestructura como Código (IaC).
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-blue block uppercase">Inferencia local // TinyML</span>
            <span class="font-tech text-3xl font-bold text-bio-text">312 ms</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Clasificación de topología de placa sobre matriz RGB565 con certeza P ≥ 0.94.</p>
          </div>
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-brown block uppercase">Políticas // Anomalias</span>
            <span class="font-tech text-3xl font-bold text-bio-text">Δt = 300s</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Ventana estricta de mitigación y cooldown para alertas críticas vía Telegram API.</p>
          </div>
        </div>

        <div>
          <h4 class="font-tech text-base text-bio-green mb-2 uppercase">Integridad Operacional</h4>
          <p class="font-sans text-xs text-bio-text/75 leading-relaxed">
            La integridad estructural se evalúa constantemente comparando métricas contra las restricciones estables de borde:
          </p>
          <div class="p-3 bg-black/5 rounded-lg border border-bio-text/10 font-code text-xs text-bio-green text-center">
            T_min ≤ T ≤ T_max  ∧  H_min ≤ H ≤ H_max  ∧  S_vibration &lt; 0.80
          </div>
        </div>
      </div>
    `,
    github: "#",
    video: "#"
  },
  {
    id: "salli",
    titulo: "Robot SALLI",
    subtitulo: "Plataforma robótica modular con locomoción biomimética de alta eficiencia.",
    fecha: "2024",
    rol: "Systems & Engineering Lead",
    tags: ["FreeRTOS", "ESP-IDF", "YOLOv8", "Modularity"],
    imagenObjeto: imgSalli,
    colorClase: "bio-rose",
    colorHex: "#D8A499",
    detallesHTML: `
      <div class="space-y-6">
        <div>
          <h4 class="font-tech text-lg text-bio-green mb-2 border-b border-bio-text/10 pb-1 uppercase tracking-wider">Logros de Sistemas & Diseño Mecánico</h4>
          <p class="font-sans text-xs md:text-sm text-bio-text/80 leading-relaxed">
            Dirección del ciclo de vida bajo lineamientos de calidad ISO 9001, reduciendo iteración de diseño en un 25%. Estructura mecánica modular "glue-less" de ensamble por cola de milano (dovetail), optimizada para impresión FDM.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-rose block uppercase">Frecuencia de Red // IDF</span>
            <span class="font-tech text-3xl font-bold text-bio-text">50 Hz</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Sincronización determinista de articulaciones con latencia de transporte &lt; 15 ms.</p>
          </div>
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-green block uppercase">Mantenibilidad // DownTime</span>
            <span class="font-tech text-3xl font-bold text-bio-text">&lt; 5 min</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Reparación física de módulos en campo asegurada por pernos mecánicos M3.</p>
          </div>
        </div>

        <div>
          <h4 class="font-tech text-base text-bio-green mb-2 uppercase">Inferencia en el Borde</h4>
          <p class="font-sans text-xs text-bio-text/75 leading-relaxed">
            Procesamiento y detección en tiempo real a bordo de nodos ESP32-CAM gracias a la cuantización de red y reducción de footprint de memoria:
          </p>
          <div class="p-3 bg-black/5 rounded-lg border border-bio-text/10 font-code text-xs text-bio-green text-center">
            YOLOv8-Inference-Engine ~30 FPS sin Thermal Throttling
          </div>
        </div>
      </div>
    `,
    github: "#",
    video: "#"
  },
  {
    id: "neuro-emotion",
    titulo: "Children's Emotion Recognition System",
    subtitulo: "Clasificación y regularización de expresiones faciales para registros clínicos de salud mental infantil.",
    fecha: "2025",
    rol: "Principal AI Research & Computer Vision Engineer",
    tags: ["YOLOv8-cls", "PyTorch", "Deep Learning"],
    imagenObjeto: imgNeuroEmotion,
    colorClase: "bio-blue",
    colorHex: "#8FA9C4",
    detallesHTML: `
      <div class="space-y-6">
        <div>
          <h4 class="font-tech text-lg text-bio-green mb-2 border-b border-bio-text/10 pb-1 uppercase tracking-wider">Arquitectura de Visión Computacional</h4>
          <p class="font-sans text-xs md:text-sm text-bio-text/80 leading-relaxed">
            Orquestación de un pipeline jerárquico que filtra segmentos demográficos en tiempo real (aislando la cohorte infantil) para optimizar el cómputo de inferencias en dispositivos clínicos embebidos.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-blue block uppercase">YOLOv8-cls vs ResNet18</span>
            <span class="font-tech text-3xl font-bold text-bio-text">+16.3%</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Superioridad estadística de precisión absoluta debido al mecanismo de atención interna.</p>
          </div>
          <div class="p-4 bg-white/40 border border-bio-text/5 rounded-xl">
            <span class="font-code text-[10px] text-bio-brown block uppercase">Métrica Final // F1-Score</span>
            <span class="font-tech text-3xl font-bold text-bio-text">0.706</span>
            <p class="text-[10px] text-bio-text/60 mt-1 font-sans">Mitigación efectiva de sesgos y sobreajustes hacia expresiones mayoritarias.</p>
          </div>
        </div>

        <div>
          <h4 class="font-tech text-base text-bio-green mb-2 uppercase">Espacio Categórico de Variables Clínicas</h4>
          <p class="font-sans text-xs text-bio-text/75 leading-relaxed">
            Las geometrías faciales se mapean en un espacio categórico de 4 dimensiones correspondiente a variables estandarizadas de salud mental:
          </p>
          <div class="p-3 bg-black/5 rounded-lg border border-bio-text/10 font-code text-xs text-bio-green text-center">
            Y = { Joy, Anger, Sadness, Neutral }
          </div>
        </div>
      </div>
    `,
    github: "#",
    video: "#"
  }
];
---

<LayoutBase title="Proyectos de Ingeniería">
  
  <!-- Canvas para el Patrón de Turing Aleatorio (Fondo) -->
  <div class="fixed inset-0 -z-20 w-full h-full bg-bio-bg overflow-hidden pointer-events-none transition-opacity duration-1000" id="turing-wrapper">
    <canvas id="turing-bg-proyectos" class="w-full h-full opacity-15"></canvas>
  </div>

  <!-- PANTALLA DE CARGA (INTRO ANIMATION) -->
  <div id="intro-screen" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-bio-bg transition-opacity duration-1000">
    <div class="max-w-2xl w-full px-6">
      <div id="typewriter-text" class="font-code text-lg md:text-2xl font-bold text-bio-green tracking-tight leading-relaxed"></div>
      <div id="typewriter-sub" class="font-code text-xs md:text-sm text-bio-text/60 mt-4 min-h-[2rem]"></div>
    </div>
  </div>

  <!-- TÍTULO GLOBAL -->
  <div id="global-title" class="fixed top-8 left-6 md:left-12 z-40 opacity-0 transition-all duration-[1500ms] ease-[cubic-bezier(0.22,1,0.36,1)] transform translate-y-12 scale-110 pointer-events-none">
    <div class="flex items-center gap-3">
      <span class="h-2 w-2 rounded-full bg-bio-rose animate-pulse"></span>
      <h1 class="font-tech text-xl md:text-3xl font-bold text-bio-text tracking-tight uppercase">
        Proyectos de Ingeniería
      </h1>
    </div>
    <p class="font-code text-[10px] text-bio-text/50 mt-1 ml-5 uppercase tracking-widest">Vitrina Tecnológica Interactiva</p>
  </div>

  <!-- INTERFAZ PRINCIPAL DE PROYECTOS -->
  <div id="main-interface" class="relative w-full h-[80vh] mt-24 opacity-0 transition-opacity duration-1000 flex items-center">
    
    <!-- COLUMNA IZQUIERDA: Textos y Controladores del Carrusel -->
    <div id="carousel-text-panel" class="w-full md:w-5/12 h-full flex flex-col justify-center px-4 md:px-12 z-20 transition-all duration-700 ease-in-out">
      
      <!-- Contenedor dinámico de textos -->
      <div class="relative w-full h-72">
        {proyectosData.map((proj, index) => (
          <div id={`text-item-${index}`} class={`absolute inset-0 flex flex-col justify-center transition-all duration-700 ease-[cubic-bezier(0.87,0,0.13,1)] ${index === 0 ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-12 pointer-events-none'}`}>
            <span class="font-code text-[10px] bg-bio-text/5 text-bio-green px-2 py-1 rounded w-max mb-3 border border-bio-text/10">{proj.fecha} // {proj.rol}</span>
            <h2 class="font-tech text-3xl md:text-4xl font-bold text-bio-text leading-tight mb-4">{proj.titulo}</h2>
            <p class="font-sans text-sm text-bio-text/70 leading-relaxed mb-8">{proj.subtitulo}</p>
            
            <button id={`cta-btn-${index}`} onclick={`abrirDetalle(${index})`} class="group relative w-max font-code text-xs font-bold text-bio-bg bg-bio-text px-6 py-3 rounded-xl overflow-hidden transition-all hover:scale-105 shadow-md">
              <span id={`cta-label-${index}`} class="relative z-10 flex items-center gap-2">
                VER INVESTIGACIÓN Y MÉTRICAS 
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </span>
              <div class="absolute inset-0 bg-bio-green transform scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100 z-0"></div>
            </button>
          </div>
        ))}
      </div>

      <!-- Navegación del Carrusel Vertical -->
      <div class="flex items-center gap-4 mt-8">
        <div class="flex flex-col gap-2">
          <button onclick="moverCarrusel(-1)" class="p-2 rounded-full border border-bio-text/20 text-bio-text/50 hover:text-bio-text hover:border-bio-text transition-all"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg></button>
          <button onclick="moverCarrusel(1)" class="p-2 rounded-full border border-bio-text/20 text-bio-text/50 hover:text-bio-text hover:border-bio-text transition-all"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button>
        </div>
        <div class="flex gap-2">
          {proyectosData.map((_, index) => (
            <div id={`dot-${index}`} class={`w-1.5 h-12 rounded-full transition-all duration-500 ${index === 0 ? 'bg-bio-green' : 'bg-bio-text/10'}`}></div>
          ))}
        </div>
      </div>
    </div>

    <!-- PANEL LATERAL: Composición Completa Full-Bleed -->
    <!-- En Carrusel: Ocupa el centro-derecha. En Detalle: Ocupa la derecha con morfología estricta -->
    <div id="image-morph-container" class="absolute right-0 top-1/2 -translate-y-1/2 w-full md:w-[58%] h-[65vh] md:h-[75vh] rounded-l-3xl overflow-hidden transition-all duration-[900ms] ease-[cubic-bezier(0.25,1,0.5,1)] z-10 border-l border-y border-bio-text/10 shadow-xl will-change-transform">
      
      <!-- Track vertical de imágenes -->
      <div id="image-track" class="relative w-full h-full transition-transform duration-[900ms] ease-[cubic-bezier(0.25,1,0.5,1)]">
        {proyectosData.map((proj, index) => (
          <div class="absolute w-full h-full" style={`top: ${index * 100}%;`}>
            <!-- Imagen optimizada de Astro cubriendo todo el espectro -->
            <Image 
              src={proj.imagenObjeto} 
              alt={proj.titulo}
              width={1000}
              height={700}
              class="object-cover w-full h-full select-none"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- CAPA DE DETALLES DEL PROYECTO (Sub-página inyectada) -->
    <div id="detail-panel" class="absolute left-0 top-0 w-full md:w-7/12 h-full bg-bio-bg z-30 opacity-0 pointer-events-none transition-all duration-700 ease-in-out transform -translate-x-12 flex flex-col">
      
      <!-- Botón Volver -->
      <button onclick="cerrarDetalle()" class="w-max mb-8 flex items-center gap-2 font-code text-xs font-bold text-bio-text hover:text-bio-green transition-colors px-4 py-2 border border-bio-text/10 rounded-lg bg-white/50 hover:bg-white shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        VOLVER AL EXPLORADOR
      </button>

      <!-- Contenedor scrollable de información técnica -->
      <div class="flex-grow overflow-y-auto pr-6 custom-scrollbar pb-12">
        
        {proyectosData.map((proj, index) => (
          <div id={`detail-content-${index}`} class="hidden flex-col gap-6 animate-[fadeIn_0.5s_ease-out]">
            
            <div>
              <h2 class="font-tech text-3xl font-bold text-bio-text mb-2">{proj.titulo}</h2>
              <p class="font-code text-[11px] text-bio-text/60 uppercase tracking-wide">{proj.rol} // {proj.fecha}</p>
            </div>

            <!-- Etiquetas Stack Tecnológico -->
            <div class="flex flex-wrap gap-2 mb-4">
              {proj.tags.map(tag => (
                <span class="font-code text-[10px] bg-bio-blue/10 text-bio-blue border border-bio-blue/20 px-2 py-1 rounded font-bold">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Inyección de HTML dinámico del MarkDown -->
            <div class="prose prose-sm prose-p:font-sans prose-headings:font-tech text-bio-text bg-white/50 p-6 rounded-2xl border border-bio-text/5 shadow-sm" set:html={proj.detallesHTML} />

            <!-- Enlaces Interactivos -->
            <div class="flex gap-4 mt-4">
              <a href={proj.github} class="flex items-center gap-2 px-4 py-2 bg-[#121314] text-white rounded-lg font-code text-xs font-bold transition-transform hover:scale-105">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                Repositorio GitHub
              </a>
              <a href={proj.video} class="flex items-center gap-2 px-4 py-2 border border-[#121314] text-[#121314] rounded-lg font-code text-xs font-bold hover:bg-[#121314] hover:text-white transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Ver Demostración
              </a>
            </div>

          </div>
        ))}

      </div>
    </div>

  </div>
</LayoutBase>

<style>
  /* Scrollbar personalizado para el panel de detalles */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #8C7870;
    border-radius: 4px;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // =====================================================================
  // LÓGICA DE NAVEGACIÓN Y CARRUSEL VERTICAL INFINITO
  // =====================================================================
  let currentIndex = 0;
  const totalProjects = 4; // Peter, IoT, Salli, Neuro-Emotion
  
  let estadoActual = 'INTRO'; // INTRO -> CARRUSEL -> DETALLE
  let trackEl: HTMLElement, morphContainer: HTMLElement, textPanel: HTMLElement, detailPanel: HTMLElement;
  let isTuringRunning = false;
  let turingAnimId: number | null = null;

  async function sleep(ms: number) { return new Promise(r => setTimeout(r, ms)); }
  
  // 1. Terminal Intro Typewriter Sequence
  async function runIntroSequence() {
    const textEl = document.getElementById('typewriter-text');
    const subEl = document.getElementById('typewriter-sub');
    const introScreen = document.getElementById('intro-screen');
    const globalTitle = document.getElementById('global-title');
    const mainUI = document.getElementById('main-interface');
    
    if(!textEl || !subEl || !introScreen || !globalTitle || !mainUI) return;

    const msg1 = "> INICIANDO VITRINA DE INGENIERÍA...";
    let current = "";
    for(const char of msg1) {
      current += char;
      textEl.innerHTML = current + '<span class="animate-pulse">_</span>';
      await sleep(35);
    }
    await sleep(300);

    const msg2 = "> ENLAZANDO REPOSITORIOS, SIMULACIONES Y METRICAS DE RENDIMIENTO";
    current = "";
    for(const char of msg2) {
      current += char;
      subEl.innerHTML = current + '<span class="animate-pulse">_</span>';
      await sleep(15);
    }
    await sleep(500);

    // Fade out de la pantalla de carga
    introScreen.style.opacity = '0';
    
    // El título vuela dinámicamente hacia arriba
    globalTitle.style.opacity = '1';
    globalTitle.style.transform = 'translate(0px, 0px) scale(1)';
    
    await sleep(400);
    introScreen.style.display = 'none';
    
    mainUI.style.opacity = '1';
    estadoActual = 'CARRUSEL';
    
    isTuringRunning = true;
    initTuringBackground();
  }

  // 2. Carrusel Vertical Infinito con Modulo (%)
  (window as any).moverCarrusel = (dir: number) => {
    if(estadoActual !== 'CARRUSEL') return;
    
    // Ocultar textos anteriores
    const oldText = document.getElementById(`text-item-${currentIndex}`);
    const oldDot = document.getElementById(`dot-${currentIndex}`);
    if(oldText) {
      oldText.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      oldText.classList.add('opacity-0', '-translate-y-12', 'pointer-events-none');
    }
    if(oldDot) {
      oldDot.classList.remove('bg-bio-green');
      oldDot.classList.add('bg-bio-text/10');
    }

    // Aritmética modular para carrusel infinito circular
    currentIndex = (currentIndex + dir + totalProjects) % totalProjects;

    // Inyectar textos nuevos desde abajo
    const newText = document.getElementById(`text-item-${currentIndex}`);
    const newDot = document.getElementById(`dot-${currentIndex}`);
    if(newText) {
      newText.classList.remove('-translate-y-12');
      newText.classList.add('translate-y-12');
      void newText.offsetWidth; // Forzar reflow nativo de rendering
      newText.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
      newText.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    }
    if(newDot) {
      newDot.classList.remove('bg-bio-text/10');
      newDot.classList.add('bg-bio-green');
    }

    // Mover track con translate acelerado por hardware
    trackEl = document.getElementById('image-track')!;
    trackEl.style.transform = `translateY(-${currentIndex * 100}%)`;
  };

  // 3. Modales y Morphing de Detalle FLIP a 60FPS
  (window as any).abrirDetalle = async (index: number) => {
    if (estadoActual !== 'CARRUSEL') return;
    
    const labelEl = document.getElementById(`cta-label-${index}`);
    const btnEl = document.getElementById(`cta-btn-${index}`);
    if(!labelEl || !btnEl) return;

    // Desactivar clicks durante la animación táctica de consola
    btnEl.style.pointerEvents = 'none';

    // Animación interactiva de carga tipo terminal
    const logs = ["> INJECTING LINK...", "> COMPILING METRICS...", "> OK"];
    for (const log of logs) {
      labelEl.innerHTML = `<span class="font-code text-[11px] text-bio-blue animate-pulse">${log}</span>`;
      await sleep(180);
    }
    
    estadoActual = 'DETALLE';
    
    // Kill switch de Turing para liberar el 100% de la CPU/GPU
    isTuringRunning = false;
    const turingWrapper = document.getElementById('turing-wrapper');
    if(turingWrapper) turingWrapper.style.opacity = '0';

    morphContainer = document.getElementById('image-morph-container')!;
    textPanel = document.getElementById('carousel-text-panel')!;
    detailPanel = document.getElementById('detail-panel')!;

    // Desaparecer textos del carrusel
    textPanel.classList.remove('opacity-100');
    textPanel.classList.add('opacity-0', 'pointer-events-none');

    // Transición morphing FLIP de la imagen: Pasa a ocupar la derecha total sin contenedor
    morphContainer.classList.remove('md:w-[58%]', 'md:right-12');
    morphContainer.classList.add('md:w-[36%]', 'right-0', 'h-screen', 'rounded-none', 'shadow-2xl');

    // Cargar contenido correspondiente
    for(let i=0; i<totalProjects; i++) {
      const content = document.getElementById(`detail-content-${i}`);
      if(content) content.classList.add('hidden');
    }
    const activeContent = document.getElementById(`detail-content-${index}`);
    if(activeContent) {
      activeContent.classList.remove('hidden');
      activeContent.classList.add('flex');
    }

    // Restaurar etiqueta de botón para el próximo ciclo
    labelEl.innerHTML = `VER INVESTIGACIÓN Y MÉTRICAS <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>`;
    btnEl.style.pointerEvents = 'auto';

    // Desplegar panel lateral izquierdo de información técnica
    setTimeout(() => {
      detailPanel.classList.remove('opacity-0', '-translate-x-12', 'pointer-events-none');
      detailPanel.classList.add('opacity-100', 'translate-x-0', 'pointer-events-auto');
    }, 400);
  };

  (window as any).cerrarDetalle = () => {
    if (estadoActual !== 'DETALLE') return;
    estadoActual = 'CARRUSEL';

    // Cerrar panel lateral izquierdo
    detailPanel.classList.remove('opacity-100', 'translate-x-0', 'pointer-events-auto');
    detailPanel.classList.add('opacity-0', '-translate-x-12', 'pointer-events-none');

    // Descomprimir imagen al carrusel central
    setTimeout(() => {
      morphContainer.classList.remove('md:w-[36%]', 'right-0', 'h-screen', 'rounded-none', 'shadow-2xl');
      morphContainer.classList.add('md:w-[58%]', 'md:right-12');
      
      textPanel.classList.remove('opacity-0', 'pointer-events-none');
      textPanel.classList.add('opacity-100');

      // Re-encender el motor Turing y desvanecer su opacidad sutil
      isTuringRunning = true;
      const turingWrapper = document.getElementById('turing-wrapper');
      if(turingWrapper) turingWrapper.style.opacity = '1';
      initTuringBackground(); 

    }, 300);
  };

  // =====================================================================
  // MOTOR DE TURING AUTO-LIMPIABLE CON RESPETO A MEMORIA
  // =====================================================================
  function initTuringBackground() {
    if(turingAnimId !== null) return; 

    const canvas = document.getElementById('turing-bg-proyectos') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const gridW = 640;
    const gridH = 480;

    let U = new Float32Array(gridW * gridH).fill(1.0);
    let V = new Float32Array(gridW * gridH).fill(0.0);
    let nextU = new Float32Array(gridW * gridH);
    let nextV = new Float32Array(gridW * gridH);

    // Semilla de perturbación aleatoria única
    for (let s = 0; s < 8; s++) {
      const cx = Math.floor(Math.random() * (gridW - 10)) + 5;
      const cy = Math.floor(Math.random() * (gridH - 10)) + 5;
      for (let dy = -4; dy <= 4; dy++) {
        for (let dx = -4; dx <= 4; dx++) {
          if (dx*dx + dy*dy < 16) {
            U[(cx+dx) + (cy+dy)*gridW] = 0.5;
            V[(cx+dx) + (cy+dy)*gridW] = 0.25 + Math.random()*0.3;
          }
        }
      }
    }

    const Feed = 0.0367;
    const Kill = 0.0649;
    
    let canvasW = canvas.width = window.innerWidth;
    let canvasH = canvas.height = window.innerHeight;

    function stepTuring() {
      // Condición estricta de salida: Pestaña cerrada o detalle abierto
      if (!isTuringRunning || !canvas.isConnected) {
        if(turingAnimId) cancelAnimationFrame(turingAnimId);
        turingAnimId = null;
        return;
      }

      for (let iter = 0; iter < 5; iter++) {
        for (let y = 1; y < gridH - 1; y++) {
          for (let x = 1; x < gridW - 1; x++) {
            const i = x + y * gridW;
            const u = U[i];
            const v = V[i];
            
            const lapU = (U[i-1] + U[i+1] + U[i-gridW] + U[i+gridW])*0.2 + (U[i-gridW-1] + U[i-gridW+1] + U[i+gridW-1] + U[i+gridW+1])*0.05 - u;
            const lapV = (V[i-1] + V[i+1] + V[i-gridW] + V[i+gridW])*0.2 + (V[i-gridW-1] + V[i-gridW+1] + V[i+gridW-1] + V[i+gridW+1])*0.05 - v;
            
            const uvv = u * v * v;
            nextU[i] = u + (0.2 * lapU - uvv + Feed * (1 - u));
            nextV[i] = v + (0.1 * lapV + uvv - (Kill + Feed) * v);
          }
        }
        let tempU = U; U = nextU; nextU = tempU;
        let tempV = V; V = nextV; nextV = tempV;
      }

      const tCanvas = document.createElement('canvas');
      tCanvas.width = gridW; tCanvas.height = gridH;
      const tCtx = tCanvas.getContext('2d')!;
      const imgD = tCtx.createImageData(gridW, gridH);
      
      for (let i = 0; i < gridW * gridH; i++) {
        const val = V[i];
        const p = i * 4;
        imgD.data[p] = 78;   // R (#4E5E52)
        imgD.data[p+1] = 94; // G
        imgD.data[p+2] = 82; // B
        imgD.data[p+3] = Math.floor(val * 255 * 2.8); // Opacidad
      }
      tCtx.putImageData(imgD, 0, 0);
      ctx!.clearRect(0, 0, canvasW, canvasH);
      ctx!.imageSmoothingEnabled = true;
      ctx!.drawImage(tCanvas, 0, 0, canvasW, canvasH);

      turingAnimId = requestAnimationFrame(stepTuring);
    }
    
    const onResize = () => {
      if(canvas.isConnected) {
        canvasW = canvas.width = window.innerWidth;
        canvasH = canvas.height = window.innerHeight;
      } else {
        window.removeEventListener('resize', onResize);
      }
    };
    window.addEventListener('resize', onResize);

    stepTuring();
  }

  // Escuchas del Ciclo de Vida Nativos de Astro
  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname.includes('/proyectos')) {
      currentIndex = 0;
      estadoActual = 'INTRO';
      isTuringRunning = false;
      
      const mainUI = document.getElementById('main-interface');
      const introScreen = document.getElementById('intro-screen');
      if(mainUI) mainUI.style.opacity = '0';
      if(introScreen) {
        introScreen.style.display = 'flex';
        introScreen.style.opacity = '1';
      }
      
      runIntroSequence();
    } else {
      isTuringRunning = false;
    }
  });
</script>